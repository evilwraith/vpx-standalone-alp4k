'*******************************************

Sub Table1_KeyDown(ByVal keycode)

	If keycode = PlungerKey and VRRoom = 1 Then PinCab_GunTrigger.y = PinCab_GunTrigger.y + 9: PinCab_GunTrigger.z = 3 		'VR Callout
	If keycode = LeftFlipperKey and VRRoom = 1 Then VRFlipperLeft.x = VRFlipperLeft.x + 5	 'VR Callout
	If keycode = RightFlipperKey and VRRoom = 1 Then VRFlipperRight.x = VRFlipperRight.x - 5 'VR Callout
	If keycode = Startgamekey and VRRoom = 1 then 
		UnderCabTimer.enabled = false
		UCFadeInTimer.enabled = false
		UCFadeOutTimer.enabled = false
		UCStrobeTimer.enabled = false
		UCShortStrobeBlueTimer.enabled = false
		UndercabTest1.opacity = 0
		UndercabTestBlue.opacity = 0
		VRStartButton.y = VRStartButton.y - 4
		VRGameInPlay = true
		VRStartButton.blenddisablelighting = 25
	end if
	If keycode = Startgamekey then UCAttractTimer.enabled = false: UCDOF 0
	
	'keep this at the top to short circuit the keystrokes if in highscore mode
	If hsbModeActive Then
        EnterHighScoreKey(keycode)
        Exit Sub
    End If
	'This intercepts the keystrokes when put in Villain Select Mode
	'Must be at top of Key Down
	If inVillainSelect = True Then
		VillainSelect keycode
		Exit Sub
	End If
	'This intercepts the keystrokes when put in Die Hard Select Mode
	'Must be at top of Key Down
	If inDieHardSelect = True Then
		DieHardSelect keycode
		Exit Sub
	End If
	

	Dim tmp
	If (NOT bTilted) And (Not bDieHarderFailed) Then
		If keycode = LeftFlipperKey And bFlippersEnabled Then
			DOF 101,DOFOn
			FlipperActivate LeftFlipper, LFPress
			SolLFlipper True
			If 0 = StagedFlipperMod Then
				SolULFlipper True
				If (Not Player(CurrentPlayer).ParkMBReady) _ 
				And (ModeRunning <> WizardModePhaseThree) Then
					ControlMagUpPFL True
				End If
			End If
			nTimeUpperLeftFlip = GameTime
			' double flip skip if flips are less than 50 ms apart
			If (GameTime - nTimeLowerRightFlip) < 50 Then
				pupCheckPlayerSkipVideo
			End If
			Player(CurrentPlayer).DIElanes.RotateLeft
			UpdateLightsLanes
			tmp = Blink(1,1)		 ' Toplanes rotate
			Blink(1,1)=Blink(2,1)
			Blink(2,1)=Blink(3,1)
			Blink(3,1)= tmp  
		End If

		If (1 = StagedFlipperMod) And (30 = keycode) And bFlippersEnabled Then
			SolULFlipper True
			If (Not Player(CurrentPlayer).ParkMBReady) _ 
			And (ModeRunning <> WizardModePhaseThree) Then
				ControlMagUpPFL True
			End If
		End If

		If keycode = RightFlipperKey And bFlippersEnabled Then
			DOF 102,DOFOn
			FlipperActivate RightFlipper, RFPress
			SolRFlipper True
			nTimeLowerRightFlip = GameTime
			' double flip skip if flips are less than 50 ms apart
			If (GameTime - nTimeUpperLeftFlip) < 50 Then
				pupCheckPlayerSkipVideo
			End If
			If 0 = StagedFlipperMod Then
				If (Not Player(CurrentPlayer).ParkMBReady) _ 
				And (ModeRunning <> WizardModePhaseThree) Then
					ControlMagUpPFR True
				End If
			End If
			Player(CurrentPlayer).DIElanes.RotateRight
			UpdateLightsLanes
			tmp=Blink(3,1) 			' Toplanes rotate
			Blink(3,1)=Blink(2,1)  
			Blink(2,1)=Blink(1,1)  
			Blink(1,1)= tmp
		End If

		If (1 = StagedFlipperMod) And (40 = keycode) And bFlippersEnabled Then
			If (Not Player(CurrentPlayer).ParkMBReady) _ 
			And (ModeRunning <> WizardModePhaseThree) Then
				ControlMagUpPFR True
			End If
		End If

		If keycode = PlungerKey Then 
			If bBallInPlungerLane=True Then DOF 122,DOFPulse

			If CatchSkillShot = True Then
				SkillShotReceived
			End If

			'Plunger.Pullback 
			bAutoPlunger = True
			autoplungerdelay.interval = 300
			autoplungerdelay.enabled = True
'			PlungerIM.Strength = 55 : PlungerIM.AutoFire 
		End If
		'If keycode = PlungerKey Then Plunger.Fire : PlungerIM.Fire : SoundPlungerPull

		If keycode = LeftTiltKey Then Nudge 90, 2 : SoundNudgeLeft : CheckTilt
		If keycode = RightTiltKey Then Nudge 270, 2 : SoundNudgeRight : CheckTilt
		If keycode = CenterTiltKey Then Nudge 0, 3 : SoundNudgeCenter : CheckTilt

		If keycode = MechanicalTilt Then 
			SoundNudgeCenter
			CheckMechTilt
		End If

		If keycode = StartGameKey Then 
			SoundStartButton
			StartOfGame
		End If
	End If

	'If keycode = keyInsertCoin1 or keycode = keyInsertCoin2 or keycode = keyInsertCoin3 or keycode = keyInsertCoin4 Then 'Use this for ROM based games
	If keycode = AddCreditKey or keycode = AddCreditKey2 Then
		Select Case Int(rnd*3)
			Case 0: PlaySound ("Coin_In_1"), 0, CoinSoundLevel, 0, 0.25
			Case 1: PlaySound ("Coin_In_2"), 0, CoinSoundLevel, 0, 0.25
			Case 2: PlaySound ("Coin_In_3"), 0, CoinSoundLevel, 0, 0.25
		End Select
	End If

	'this is to check for skips of end of game video
	If pupGameOver = true Then

		if keycode = RightFlipperKey Then 
			nTimeLowerRightFlip = GameTime
			' double flip skip if flips are less than 50 ms apart
			If (GameTime - nTimeUpperLeftFlip) < 50 Then
				pupCheckPlayerSkipVideo
			End If
		End If
		if keycode = LeftFlipperKey Then 
			nTimeUpperLeftFlip = GameTime
			' double flip skip if flips are less than 50 ms apart
			If (GameTime - nTimeLowerRightFlip) < 50 Then
				pupCheckPlayerSkipVideo
			End If
		End If
	End If
End Sub




Sub Table1_KeyUp(ByVal keycode)

	If keycode = PlungerKey and VRRoom =1 Then 			'VR Callout
		PinCab_GunTrigger.y = PinCab_GunTrigger.y - 9 
		PinCab_GunTrigger.z = 0
	end If
	If keycode = LeftFlipperKey and VRRoom = 1 Then VRFlipperLeft.x = VRFlipperLeft.x - 5	 'VR Callout
	If keycode = RightFlipperKey and VRRoom = 1 Then VRFlipperRight.x = VRFlipperRight.x + 5 'VR Callout
	If keycode = Startgamekey and VRRoom = 1 then 	VRStartButton.y = VRStartButton.y + 4 'VR Callout


	If pInAttract Then
		AttractFlipperCall(keycode)
	End If
	

	If keycode = LeftFlipperKey Then
		DOF 101,DOFOff
		FlipperDeActivate LeftFlipper, LFPress
		SolLFlipper False						'This would be called by the solenoid callbacks if using a ROM
		nTimeUpperLeftFlip = -1
		If 0 = StagedFlipperMod Then
			SolULFlipper False
			If (Not Player(CurrentPlayer).ParkMBReady) _ 
			And (ModeRunning <> WizardModePhaseThree) Then
				ControlMagUpPFL False
			End If
		End If
	End If

	If (1 = StagedFlipperMod) And (30 = keycode) Then
		SolULFlipper False
		If (Not Player(CurrentPlayer).ParkMBReady) _ 
		And (ModeRunning <> WizardModePhaseThree) Then
			ControlMagUpPFL False
		End If
	End If

	If keycode = RightFlipperKey Then
		DOF 102,DOFOff
		FlipperDeActivate RightFlipper, RFPress
		SolRFlipper False						'This would be called by the solenoid callbacks if using a ROM
		nTimeLowerRightFlip = -1
		If ((0 =  StagedFlipperMod) _
		And (Not Player(CurrentPlayer).ParkMBReady) _ 
		And (ModeRunning <> WizardModePhaseThree)) Then
			ControlMagUpPFR False
		End If
	End If

	If (1 = StagedFlipperMod) And (40 = keycode) Then
		If (Not Player(CurrentPlayer).ParkMBReady) _ 
		And (ModeRunning <> WizardModePhaseThree) Then
			ControlMagUpPFR False
		End If
	End If

End Sub

