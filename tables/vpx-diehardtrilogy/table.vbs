'*********************************************
'* ModeTimer
'*     Timer for the mode to be completed In
'*********************************************
Sub ModeTimer_Timer
	Dim nDisplayTime, nPoints, nMinAmbush, nUpdatesLeft
	If not bGameInPlay Then Exit Sub

	' Pause timers when the ball is held
	If inVillainSelect Or inDieHardSelect Then Exit	Sub
	If nVaultMessage > 0 Then Exit Sub

	' Track balls on magnet for wizard mode phase 3
	If ModeRunning = WizardModePhaseThree Then
		If UBound(MagUpPFL.balls) + 1 > WMPhase3Balls Then
			WMPhase3Balls = UBound(MagUpPFL.balls) + 1
			UpdateWizardModePhaseThree
		End If
		Exit Sub
	End If

	If ModeTimeLeft > 0 Then
		ModeTimeLeft = ModeTimeLeft - ModeTimer.Interval
		nUpdatesLeft = ModeTimeLeft \ ModeTimer.Interval
		' log every 5 seconds
		If nUpdatesLeft Mod 20 = 0 Then
			WriteToLog "======================", "ModeTimer_Timer, ModeTimeLeft = " & ModeTimeLeft
		End If
		If ModeTimeLeft <= 0 Then
			ModeTimeLeft = 0
			if ModeRunning = HansGruberMode Then
				WriteToLog "ModeTimer_Timer", "Ending Hans Gruber Mode"
				If DIEHARDER = DieHardMode Then FailDieHarder
				EndHansGruber False
			End If
			If ModeRunning = SimonGruberMode Then
				WriteToLog "ModeTimer_Timer", "Ending Simon Gruber Mode"
				If DIEHARDER = DieHardMode Then FailDieHarder
				EndSimonGruber False
			End If

			If ModeRunning = KarlMode Then
				WriteToLog "ModeTimer_Timer", "Ending Karl Mode"
				If DIEHARDER = DieHardMode Then FailDieHarder
				EndKarlMode False
			End If

			If ModeRunning = KatyaMode Then
				WriteToLog "ModeTimer_Timer", "Ending Katya Mode"
				If DIEHARDER = DieHardMode Then FailDieHarder
				EndKatyaMode False
			End If

			If ModeRunning = ColStuartMode Then
				WriteToLog "ModeTimer_Timer", "Ending Stuart Mode"
				If DIEHARDER = DieHardMode Then FailDieHarder
				EndStuartMode False
			End If

			If ModeRunning = "TowerMB" Then
				WriteToLog "ModeTimer_Timer", "Ending Nakatomi super jackpot"
				NakatomiEndSuper
			End If

			If ModeRunning = "ambush" Then
				WriteToLog "ModeTimer_Timer", "Ending ambush hurry up"
				endAmbushMode False
			End If

			If ModeRunning = WizardMode Then
				WriteToLog "ModeTimer_Timer", "Ending wizard mode final phase"
				EndWizardMode
			End If
		ElseIf ModeRunning = KarlMode And nUpdatesLeft Mod 10 = 0 Then
            UpdateJohnsHealth
		Elseif ModeRunning = HansGruberMode or ModeRunning = SimonGruberMode _
		or ModeRunning = KatyaMode or ModeRunning = ColStuartMode _
		or ModeRunning = "TowerMB" or ModeRunning = WizardMode Then
			If nUpdatesLeft Mod 4 = 0 Then
				nDisplayTime = (ModeTimeLeft \ 1000) - 2
				If nDisplayTime < 0 Then nDisplayTime = 0
				ShowModeTimer nDisplayTime
			End If
		Elseif ModeRunning = "ambush" Then
			If nAmbushCountdownPause > 0 Then
				nAmbushCountdownPause = nAmbushCountdownPause - ModeTimer.Interval
				If nAmbushCountdownPause <= 0 Then nAmbushCountdownPause = 0
			Else
				nMinAmbush = (0.2 * Player(CurrentPlayer).Ambush * score_Ambush_Hit)
				' When N ticks are left, count down 1/N of the value
				nPoints = nAmbushValue * (1 - (1 / (1 + (ModeTimeLeft \ ModeTimer.Interval))))
				' Round down to multiple of 10
				nPoints = (nPoints * 10) \ 10
				If nPoints > nMinAmbush Then
					nAmbushValue = nPoints
				End If
				PupShowGameMessage "AMBUSH HURRY-UP! " & FormatScore(nAmbushValue)
			End If
		End If
	End If

	If MultiplierTimeLeft > 0 Then
		MultiplierTimeLeft = MultiplierTimeLeft - ModeTimer.Interval
		If MultiplierTimeLeft = 10000 Or MultiplierTimeLeft = 6000 Then
			WriteToLog "ModeTimer_Timer", "Playfield X expiring - 10 or 6 seconds left"
			' blink faster
			UpdateLightsMultiplier
		ElseIf MultiplierTimeLeft <= 0 Then
			MultiplierTimeLeft = 0
			PointMultiplier = 1
			UpdateLightsMultiplier
			WriteToLog "ModeTimer_Timer", "Playfield X expired, PointMultiplier = " & PointMultiplier
		End If
	End If

End Sub



