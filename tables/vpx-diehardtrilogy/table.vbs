' DRAIN & RELEASE
Sub Drain_Hit 
	'vpmTimer.AddTimer 500, "Drain.kick 57, 20'" 
	UCFadeIn
	TriggerScript 500, "Drain.kick 57, 20"

	RandomSoundDrain Drain 
	BallsOnPlayfield = BallsOnPlayfield - 1
	WriteTOLog "Drain_Hit", "Balls remaining: " & BallsOnPlayfield

	If ModeRunning = WizardMode and ModeTimeLeft > 0 Then
		AddMultiball 1
		Exit Sub
	End If

	If (nTimeBallSave > 0) And (Not bTilted) And (Not bDieHarderFailed) Then
		DOF 127,DOFPulse
		If BallsOnPlayfield = 0 And Left(ModeRunning, 6) <> "Wizard" Then
			PUP_Ballsave
			nTimeBallSave = 1
		End If
		AddMultiball 1
		Exit Sub
	End If

	If "TowerMB" = ModeRunning And BallsOnPlayfield <= NakatomiPhysicalLocks Then
		NakatomiEndSuper
	End If

	If ModeRunning = WizardModePhaseOne _
	And BallsOnPlayfield + NakatomiPhysicalLocks < 3 Then
		EndWizardModePhaseOne False
		ChangeLamp 8, 0 ,"red", 75, "10", 7, 5, 5, 0
	End If

	If ModeRunning = WizardModePhaseTwo _
	And BallsOnPlayfield + WMDH2LockedBalls < 3 Then
		EndWizardModePhaseTwo False
		ChangeLamp 8, 0 ,"red", 75, "10", 7, 5, 5, 0
	End If

	If ModeRunning = WizardModePhaseThree _
	And BallsOnPlayfield < 3 Then
		EndWizardModePhaseThree False
		ChangeLamp 8, 0 ,"red", 75, "10", 7, 5, 5, 0
	End If

	If (BallsOnPlayfield = 1) And (Not bTilted) Then
		If Player(CurrentPlayer).SimonBonus And _
		((ModeRunning = "TowerMB") Or (ModeRunning = "ParkMB") Or (ModeRunning = "AirplaneMB")) Then
			Start_Ballsave Holly_BallSaverTime
			AddMultiball 1
			Player(CurrentPlayer).SimonBonus = False
		elseIf ModeRunning = "TowerMB"	Then
			END_TowerMB
			UCPulseOff

		elseIf ModeRunning = "ParkMB"	Then
			END_ParkMB
			UCPulseOff

		elseIf ModeRunning = "AirplaneMB" Then
			END_AirplaneMB
			UCPulseOff

		elseIf ModeRunning = "VaultMB" Then
			VaultMultiballEnd
			UCPulseOff
		end if
	End If

	If (BallsOnPlayfield = 0) And bGameInPlay Then
		DOF 126,DOFPulse

		Blink(50,1)=0 ' 5 diamonds not the captive one ?
		Blink(51,1)=0
		Blink(53,1)=0
		Blink(54,1)=0
		Blink(55,1)=0

		If ModeRunning = HansGruberMode Then
			EndHansGruber False
		End If

		If ModeRunning = SimonGruberMode Then
			EndSimonGruber False
		End If

		If ModeRunning = KarlMode Then
			EndKarlMode False
		End If

		If ModeRunning = KatyaMode Then
			EndKatyaMode False
		End If

		If ModeRunning = ColStuartMode Then
			EndStuartMode False
		End If

		swapDiverter(1)  ' only Park

		SetGI 0

		' FIXME: disabling drain videos temporarily to show the bonus text
'		PUP_Drain
		' fixing swap players !!/ next ball' currently   "1" to next ball

		Player(CurrentPlayer).vaultTargetCount = 0
		CloseVaultDoor ()
		l84.state=0



		EndOfBall
	End If
End Sub


