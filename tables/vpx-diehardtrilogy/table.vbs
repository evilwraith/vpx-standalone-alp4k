Sub EnableVRRoom
	' set light brightness
	VRLightWhite1.Blenddisablelighting = 25
	VRLightWhite2.Blenddisablelighting = 25
	VRLightWhite3.Blenddisablelighting = 25
	VRLightWhite4.Blenddisablelighting = 25
	VRLightWhite5.Blenddisablelighting = 25
	VRLightWhite6.Blenddisablelighting = 25
	VRLightWhite7.Blenddisablelighting = 25
	VRLightWhite8.Blenddisablelighting = 25
	VRTwinkleLight.Blenddisablelighting = 40
	VRTwinkleLight2.Blenddisablelighting = 0
	VRHeliLight.Blenddisablelighting = 1500

	DIM VRThings, el
	If VRRoom <> 0 Then
		'Hide/disable stuff first
		For Each el in BP_PinCab_Rails: el.visible = true: Next
		for each VRThings in VRMinimal:VRThings.visible = 0:Next
		for each VRThings in VRHelipad:VRThings.visible = 0:Next
		for each VRThings in VR_Cab:VRThings.visible = 0:Next
		VRMainTimer.enabled = false
		VRHeliTimer.enabled = false

		'Then show what is selected
		If VRRoom = 1 Then
			for each VRThings in VR_Cab:VRThings.visible = 1:Next
			for each VRThings in VRHelipad:VRThings.visible = 1:Next
			VRMainTimer.enabled = true
			VRHeliTimer.enabled = true
		End If
		If VRRoom = 2 Then
			for each VRThings in VR_Cab:VRThings.visible = 1:Next
			for each VRThings in VRMinimal:VRThings.visible = 1:Next
		End If
		If VRRoom = 3 Then
			PinCab_Backglass.visible = 1
			DMD.visible = true
			VRDMDBacking.visible = true
			Pincab_Backbox.visible = true
			PinCab_Grills2.visible = true
			PinCab_Grills.visible = true
		End If

	Else
		'for each VRThings in VR_Cab:VRThings.visible = 0:Next  - This is no longer needed.  All of the objects were set non-visible in the editor. 
		if DesktopMode then 
			For Each el in BP_PinCab_Rails
				el.visible = true 
			Next
		Else 
			For Each el in BP_PinCab_Rails
				el.visible = false
			Next
		End If
	End if
End Sub




