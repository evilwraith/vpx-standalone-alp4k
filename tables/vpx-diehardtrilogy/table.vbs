'*********************************************************************************************************
'* StartOfGame Logic
'*    This subroutine is called with the StartGame key is hit.
'*    Functions:
'*                1. Add Players
'*                2. Call Table Initialization????
'*********************************************************************************************************
Sub StartOfGame

	' Allow Players to be added if first ball has not been launched
	if Player(CurrentPlayer).CurrentBall = 1 And PlayersPlayingGame < 4 And PlayersPlayingGame > 0 Then
		PlayersPlayingGame = PlayersPlayingGame + 1

		PlaySound ("DHYippee_Ki_Yay"), 0, CoinSoundLevel, 0, 0.25
		PupEnablePlayer
		UpdateLightsAll
		WriteTOLog "StartOfGame","PlayersPlayingGame = " & PlayersPlayingGame
' fixing SOUND ! PUP ?
	End If
	
	pupResetPupPlayersInGame

	' Do not allow starting a game while emptying the Nakatomi lock
	If bBallInPlungerLane=False And bGameInPlay=False And BallsOnPlayfield < 1 Then
		AttractEnd
		' Reset Nakatomi lock state (now that we know it's empty)
		LockKicker1.enabled=True
		LockKicker2.enabled=False
		LockKicker3.enabled=False
		WMDH2LockedBalls = 0
		WMPhase3Balls = 0

		LeftSlingshot.Disabled = 0
		RightSlingshot.Disabled = 0

		bFlippersEnabled = True
		bBallInPlungerLane = True
		PlayersPlayingGame = 1
		bulletattract = 0
		lightCtrl.LightOff f140
		lightCtrl.LightOff f141

		BallInPlay = 1 'TESTING ONLY Will need to be wired in appropriately
		Player(CurrentPlayer).CurrentBall = BallInPlay

		pDMDStartGame ' call a pupdmd method to perform game startup actions

		ResetForNewBall
		ReleaseNewBall
	End If


end Sub


Sub NextPlayer

	'if this is the player's last ball check for highscore
	if (Player(CurrentPlayer).CurrentBall = BallsPerGame) _
	Or (Player(CurrentPlayer).WizardStageReached > 0) Then
			pDMDSetPage(pScores) 
			pDMDSetHUD 1
			CheckHighscore
			Exit Sub
	End If

	'otherwise change to next player
	ChangePlayer

End Sub

' Added to be able to call out of band of NextPlayer
Sub ChangePlayer
	Dim nPlayersAvailable, i

	nPlayersAvailable = 0
	For i = 1 to PlayersPlayingGame
		If 0 = Player(i).WizardStageReached and Player(i).CurrentBall < 3 Then
			nPlayersAvailable = nPlayersAvailable + 1
		End If
	Next

	If nPlayersAvailable = 0 Then
		EndOfGame	
		Exit Sub
	End If

	SetGIColor GIdefault1,GIdefault2,GIdefault3
	'changes current player
	for i = 1 to PlayersPlayingGame
		if PlayersPlayingGame > 1 Then
			if CurrentPlayer = PlayersPlayingGame Then
				CurrentPlayer = 1
			Else
				CurrentPlayer = CurrentPlayer + 1
			End If
		End If

		If Player(CurrentPlayer).CurrentBall = 3 Then
			EndOfGame	
			Exit Sub
		End If

		If 0 = Player(CurrentPlayer).WizardStageReached Then
			Exit For
		End If
	Next

	'sets up the next ball in play and updates the dmd for player
	WriteToLog "NextPlayer", "CurrentPlayer = " & CurrentPlayer
	BallInPlay = Player(CurrentPlayer).CurrentBall
	BallInPlay = BallInPlay + 1
	Player(CurrentPlayer).CurrentBall = BallInPlay
	GameplayRandomMusic
	pDMDSetPage(pScores) 
	pDMDSetHUD 1
	pupChangeDMDBackground 0 ' Do we need to track each player's current background screen?
	ResetForNewBall
	pupUpdatePlayer
	ReleaseNewBall

End Sub

