'****************************

Sub Start_Ballsave(time)
	nTimeBallSave = nTimeBallSave + time
	BallSaveTimer.Enabled = True
	ChangeLamp eInsertShootAgain, 2, "red", 150, "10", 7, 2, 2, 0 ' ballsave 	
End Sub

Sub BallSaveTimer_Timer
	nTimeBallSave = nTimeBallSave - BallSaveTimer.interval
	If nTimeBallSave <= 0 Then
		nTimeBallSave = 0
		BallSaveTimer.Enabled = False
		If ModeRunning = WizardMode Then
			ChangeLamp eInsertShootAgain, 2, "red", 150, "10", 7, 2, 2, 0
		ElseIf Player(CurrentPlayer).ExtraBalls > 0 Then
			ChangeLampState eInsertShootAgain, 1
		Else
			ChangeLampState eInsertShootAgain, 0
		End If
		UpdateLightsHolly
	' Turn off insert light the first time there is 2.5 sec or less remaining
	Elseif nTimeBallSave <= 2500 and nTimeBallSave + BallSaveTimer.interval > 2500 Then
		If Player(CurrentPlayer).ExtraBalls > 0 Then
			ChangeLamp eInsertShootAgain, 1, "red", 150, "10", 7, 2, 2, 0
		Else
			ChangeLamp eInsertShootAgain, 0, "red", 150, "10", 7, 2, 2, 0
		End If
	' Blink insert light faster the first time there is 5 sec or less remaining
	Elseif nTimeBallSave <= 5000 and nTimeBallSave + BallSaveTimer.interval > 5000 Then
		ChangeLamp eInsertShootAgain, 2 ,"red", 75, "10", 16, 2, 2, 0
	End If
End Sub


