Dim SwitchHitTimes(50)
Const SwitchHitRecentlyTime = 1500  'this threshold determines if a swtich was recently hit

Sub SwitchWasHit(swName)
	Select Case swName
		Case "swPlunger" 			: SwitchHitTimes(1) = gametime
		Case "swLeftInlane" 		: SwitchHitTimes(2) = gametime
		Case "swLeftInlane" 		: SwitchHitTimes(3) = gametime
		Case "swRightInlane" 		: SwitchHitTimes(4) = gametime
		Case "swRightOutlane" 		: SwitchHitTimes(5) = gametime
		Case "swLeftOrb1" 			: SwitchHitTimes(6) = gametime
		Case "swLeftOrb2" 			: SwitchHitTimes(7) = gametime
		Case "swRightOrb1" 			: SwitchHitTimes(8) = gametime
		Case "swRightOrb2" 			: SwitchHitTimes(9) = gametime
		Case "swMidOrb" 			: SwitchHitTimes(10) = gametime
		Case "swTopLane1" 			: SwitchHitTimes(11) = gametime
		Case "swTopLane2" 			: SwitchHitTimes(12) = gametime
		Case "swTopLane3" 			: SwitchHitTimes(13) = gametime
		Case "swDivRamp" 			: SwitchHitTimes(14) = gametime
		Case "swDivPark" 			: SwitchHitTimes(15) = gametime
		Case "swRamproll1" 			: SwitchHitTimes(16) = gametime
		Case "swRamproll2" 			: SwitchHitTimes(17) = gametime
		Case "swRamproll3" 			: SwitchHitTimes(18) = gametime
		Case "swRamproll4" 			: SwitchHitTimes(19) = gametime
		Case "swRamproll5" 			: SwitchHitTimes(20) = gametime
		Case "swRamproll6" 			: SwitchHitTimes(21) = gametime
		Case "swRamproll7" 			: SwitchHitTimes(22) = gametime
		Case "swRamproll8" 			: SwitchHitTimes(23) = gametime
		Case "swRamproll9" 			: SwitchHitTimes(24) = gametime
		Case "swRamproll10" 		: SwitchHitTimes(25) = gametime
		Case "TrPF1" 				: SwitchHitTimes(26) = gametime
		Case "TrPF2" 				: SwitchHitTimes(27) = gametime
		Case "TrPF3" 				: SwitchHitTimes(28) = gametime
		Case "swScoopHit"			: SwitchHitTimes(29) = gametime


	End Select
End Sub

Function SwitchRecentlyHit(swName)
	dim delta : delta = SwitchHitRecentlyTime + 1
	Select Case swName
		Case "swPlunger" 			: delta = gametime - SwitchHitTimes(1)
		Case "swLeftInlane" 		: delta = gametime - SwitchHitTimes(2)
		Case "swLeftInlane" 		: delta = gametime - SwitchHitTimes(3)
		Case "swRightInlane" 		: delta = gametime - SwitchHitTimes(4)
		Case "swRightOutlane" 		: delta = gametime - SwitchHitTimes(5)
		Case "swLeftOrb1" 			: delta = gametime - SwitchHitTimes(6)
		Case "swLeftOrb2" 			: delta = gametime - SwitchHitTimes(7)
		Case "swRightOrb1" 			: delta = gametime - SwitchHitTimes(8)
		Case "swRightOrb2" 			: delta = gametime - SwitchHitTimes(9)
		Case "swMidOrb" 			: delta = gametime - SwitchHitTimes(10)
		Case "swTopLane1" 			: delta = gametime - SwitchHitTimes(11)
		Case "swTopLane2" 			: delta = gametime - SwitchHitTimes(12)
		Case "swTopLane3" 			: delta = gametime - SwitchHitTimes(13)
		Case "swDivRamp" 			: delta = gametime - SwitchHitTimes(14)
		Case "swDivPark" 			: delta = gametime - SwitchHitTimes(15)
		Case "swRamproll1" 			: delta = gametime - SwitchHitTimes(16)
		Case "swRamproll2" 			: delta = gametime - SwitchHitTimes(17)
		Case "swRamproll3" 			: delta = gametime - SwitchHitTimes(18)
		Case "swRamproll4" 			: delta = gametime - SwitchHitTimes(19)
		Case "swRamproll5" 			: delta = gametime - SwitchHitTimes(20)
		Case "swRamproll6" 			: delta = gametime - SwitchHitTimes(21)
		Case "swRamproll7" 			: delta = gametime - SwitchHitTimes(22)
		Case "swRamproll8" 			: delta = gametime - SwitchHitTimes(23)
		Case "swRamproll9" 			: delta = gametime - SwitchHitTimes(24)
		Case "swRamproll10" 		: delta = gametime - SwitchHitTimes(25)
		Case "TrPF1" 				: delta = gametime - SwitchHitTimes(26)
		Case "TrPF2" 				: delta = gametime - SwitchHitTimes(27)
		Case "TrPF3" 				: delta = gametime - SwitchHitTimes(28)
		Case "swScoopHit"			: delta = gametime - SwitchHitTimes(29)

	End Select
	If delta < SwitchHitRecentlyTime Then
		SwitchRecentlyHit = True
	Else
		SwitchRecentlyHit = False
	End If
End Function




