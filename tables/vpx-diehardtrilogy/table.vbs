	ElseIf (CurrentPlayer = 1) then PuPlayer.LabelSet pDMD,"CurScore2","",0,"{'mt':2,'color':8553090, 'size': 3, 'xpos': 43, 'ypos':97}"
	End If

	'need to shift player3 score if it is player 4 or 1's turn differently
	If (CurrentPlayer = 4) Then' Handle special cases when the label has moved
		PuPlayer.LabelSet pDMD,"CurScore3","",0,"{'mt':2,'color':8553090, 'size': 3, 'xpos': 55, 'ypos':97}"
	ElseIf (CurrentPlayer = 1) OR (CurrentPlayer = 2) Then
		PuPlayer.LabelSet pDMD,"CurScore3","",0,"{'mt':2,'color':8553090, 'size': 3, 'xpos': 65, 'ypos':97}"
	End If
	
	If NOT (CurrentPlayer = 4) Then PuPlayer.LabelSet pDMD,"CurScore4","",0,"{'mt':2,'color':8553090, 'size': 3, 'xpos': 88, 'ypos':97}"

End Sub

