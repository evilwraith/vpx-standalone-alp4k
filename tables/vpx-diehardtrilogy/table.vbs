	End If
End Sub

Sub KickerVault1_timer
	dim i, dRandom
	If "VaultMB" = ModeRunning or Left(ModeRunning, 6) = "Wizard" Then
		KickerVault1.kick 0,60
		KickerVault1.timerenabled=false
		DOF 113,DOFPulse
	elseif nVaultMessage > 0 and nVaultMessage < 7 Then
		i = nVaultMessage Mod (nVaultAwardCount - 1)
		if 0 = i then i = (nVaultAwardCount - 1)
		dRandom = Rnd
		If dRandom < 0.01 Then
			DisplayMystery eMysteryJoke1
		Elseif dRandom < 0.02 Then
			DisplayMystery eMysteryJoke2
		Else
			DisplayMystery aVaultAwards(i)
		End If
		nVaultMessage = nVaultMessage + 1
	elseif nVaultMessage >= 7 and nVaultMessage < 15 Then
		If AddTimeAvailable Then
			DisplayMystery eMysteryAddTime
		Elseif AddBallAvailable Then
			DisplayMystery eMysteryAddBall
		Else
			DisplayMystery aVaultAwards(0)
		End If
		nVaultMessage = nVaultMessage + 1
	else
		nVaultMessage = 0
		HideMysteryAward
		
		If nVaultAwardCount > 0 Then
			AwardVaultMystery aVaultAwards(0)
			nVaultAwardCount = 0
		End If

		If moderunning = "" Then SetGIColor GIdefault1,GIdefault2,GIdefault3
		
		BLS 40,44,7,3,3,2
		SetLightColor 60,"red"
		BLS 60,60,8,2,2,1
		KickerVault1.kick 0,60
		KickerVault1.timerenabled=false
		DOF 113,DOFPulse
		lightCtrl.LightColor f147, rgb(0,250,0)
		lightCtrl.Pulse f147,1 : DOF 147, DOFPulse

		CloseVaultDoor
	end if
End Sub




