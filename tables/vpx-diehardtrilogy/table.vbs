'********** VR Helipad code -Rawd- *************

Dim VRLight : VRLight = 0
Dim Stuff
dim TwinkleUp : TwinkleUp = true
dim HeliUp : HeliUp = true
Dim StartButtonSpeed: StartButtonSpeed = 0.5
Dim VRGameInPlay: VRGameInPlay = False



Sub VRMainTimer_timer()  'Runs the 4 red lights on the helipad..
	VRLight = VRLight +1
	if VRLight = 0 then VRLightLF.Blenddisablelighting = 0 :VRFrontWall.image = "NewWallOFF": VRHelipadFloor.image = "HPadOFF4"
	if VRLight = 1 then VRLightLF.Blenddisablelighting = 355: VRFrontWall.image = "NewWallLFON": VRHelipadFloor.image = "NewFloorFLON"
	if VRLight = 2 then VRLightLF.Blenddisablelighting = 0: VRFrontWall.image = "NewWallOFF": VRHelipadFloor.image = "HPadOFF4"
	if VRLight = 3 then VRLightRF.Blenddisablelighting = 355: VRFrontWall.image = "NewWallRFON": VRHelipadFloor.image = "NewFloorRFON"
	If VRLight = 4 then VRLightRF.Blenddisablelighting = 0: VRFrontWall.image = "NewWallOFF": VRHelipadFloor.image = "HPadOFF4"
	if VRLight = 5 then VRLightBL.Blenddisablelighting = 355: VRFrontWall.image = "NewWallBLON": VRHelipadFloor.image = "NewFloorBLON"
	If VRLight = 6 then VRLightBL.Blenddisablelighting = 0: VRFrontWall.image = "NewWallOFF": VRHelipadFloor.image = "HPadOFF4"
	if VRLight = 7 then VRLightBR.Blenddisablelighting = 355: VRFrontWall.image = "NewWallBRON": VRHelipadFloor.image = "NewFloorBRON"
	If VRLight = 8 then VRLightBR.Blenddisablelighting = 0: VRFrontWall.image = "NewWallOFF": VRHelipadFloor.image = "HPadOFF4"
	if VRLight = 8 then VrLight = 0
End Sub


Sub VRHeliTimer_Timer() ' Helicopter animation

	Blade2.roty = Blade2.roty +6
	if VRHeli.z <7000 and HeliUp = true then for each Stuff in VRCopter: Stuff.z = Stuff.z +45: next
	if VRHeli.z =>7000 and VRHeli.y < 56000 then 
		for each Stuff in VRCopter: Stuff.y = Stuff.y +75: next
		for each Stuff in VRCopter: Stuff.x = Stuff.x -16: next
		HeliUp = False
	end If

	if VRHeli.y => 56000 Then
		for each Stuff in VRCopter: Stuff.z = Stuff.z -24: next
		VRHeli.roty = VRHeli.roty +0.16
		VRHeliRotor1.roty = VRHeliRotor1.roty +0.16
		VRHeliRotor2.roty = VRHeliRotor2.roty +0.16
		VRHeliRotor3.roty = VRHeliRotor3.roty +0.16
	end If

	if VRHeli.z <-150000 Then  ' reset Helicopter back to start
		HeliUp = True
		VRHeli.x = 54767.08
		VRHeli.y = -209263.2
		VRHeli.z = -34000
		VRHeli.roty = 0
		blade2.x = 54719.73
		Blade2.y = -209263.2
		Blade2.z = -34000
		VRHeliLight.x = 54789.88
		VRHeliLight.y = -199045.9
		VRHeliLight.z = -30000
		VRHeliRotor1.x = 54691.23
		VRHeliRotor1.y = -209263.2
		VRHeliRotor1.z = -34000
		VRHeliRotor2.x = 54691.23
		VRHeliRotor2.y = -209263.2
		VRHeliRotor2.x = -34000
		VRHeliRotor3.x = 54691.23
		VRHeliRotor3.y = -209263.2
		VRHeliRotor3.z = -34000
		VRHeliRotor1.roty = 0
		VRHeliRotor2.roty = 0
		VRHeliRotor3.roty = 0
	end if

	'Back rotor Rudimentary animation
	Select Case Int(rnd*3)
				Case 0: VRHeliRotor1.visible = true:VRHeliRotor2.visible = false: VRHeliRotor3.visible = false
				Case 1: VRHeliRotor1.visible = false: VRHeliRotor2.visible = true: VRHeliRotor3.visible = false
				Case 2: VRHeliRotor1.visible = false:VRHeliRotor2.visible = false: VRHeliRotor3.visible = true
			End Select


	'Clouds and building lights animation..
	if TwinkleUp = true then VRTwinkleLight.Blenddisablelighting = VRTwinkleLight.Blenddisablelighting + 0.2
	if TwinkleUp = false then VRTwinkleLight.Blenddisablelighting = VRTwinkleLight.Blenddisablelighting - 0.2
	if TwinkleUp = true then VRTwinkleLight2.Blenddisablelighting = VRTwinkleLight2.Blenddisablelighting - 0.2
	if TwinkleUp = false then VRTwinkleLight2.Blenddisablelighting = VRTwinkleLight2.Blenddisablelighting + 0.2
	If VRTwinkleLight.Blenddisablelighting =< 0 then TwinkleUp = true
	If VRTwinkleLight.Blenddisablelighting => 40 then TwinkleUp = false

	VRClouds.ObjRotZ=VRClouds.ObjRotZ+0.007
	VRClouds2.ObjRotZ=VRClouds2.ObjRotZ-0.008

	' Start Button Lighting
	if VRGameInPlay = False then
	VRStartButton.blenddisablelighting = VRStartButton.blenddisablelighting + StartButtonSpeed
	if VRStartButton.blenddisablelighting =< 0 then StartButtonSpeed = 0.5
	if VRStartButton.blenddisablelighting => 40 then StartButtonSpeed = -0.5
	end If

	'Right and left VR speaker colour - to match GI
	VRLeftSpeakerFlasher.color = l114.color  'VR Callout
	VRRightSpeakerFlasher.color = l114.color  'VR Callout
End Sub


