'Captures keystrokes for the Villain Select mode
'this handles the events for the villain select
Sub VillainSelect (keycode)
	If keycode = PlungerKey Then
		
		WriteToLog "VillianSelect", "Selected Villain is " & villainArray(villainArrayIndex)
		if isDefeated(villainArray(villainArrayIndex)) = false Then
'			Plunger.PullBack
			ShowDieHardSelect
		Else
			'Play sound or message to indicate they need to move on
			PupEvent 23 ' err sorry sound effect
		End If
	End If

	If keycode = LeftFlipperKey Then
		LeftFlipper.RotateToEnd
		RandomSoundFlipperUpLeft LeftFlipper

		if villainArrayIndex = 0 Then 
			villainArrayIndex = 4
		else villainArrayIndex = villainArrayIndex - 1
