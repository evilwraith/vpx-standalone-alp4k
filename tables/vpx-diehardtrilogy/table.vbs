Sub STAction(Switch)  'called when target should actually register a hit
	Select Case Switch

		Case 1   'TargetL1
			UCFlashBlue
			HollyTargetSounds
			DOF 109,DOFPulse
			If Not bGameInPlay Then Exit Sub
			Dim bHitLeft, bHitRight
			BLS 32,32,4,2,2,0
			AddScore score_hollytargets

			If ModeRunning="" Then

				If Player(CurrentPlayer).NakatomiMBAvailable Then
					If (Not Player(CurrentPlayer).TowerLock) And (Not Player(CurrentPlayer).NakatomiTargetHitL) Then
						Player(CurrentPlayer).BonusMultiballs = _
						Player(CurrentPlayer).BonusMultiballs + bonus_mball_advance
						Player(CurrentPlayer).NakatomiTargetHitL = True
						checkTowerLock
						UpdateLightsNakatomi
					Else
						Player(CurrentPlayer).BonusMultiballs = _
						Player(CurrentPlayer).BonusMultiballs + bonus_mball_no_advance
					End If
				End If

				If Not Player(CurrentPlayer).HOLLYtargets.Contains(2) Then
					Player(CurrentPlayer).HOLLYtargets.Add 2
					ChangeLamp 32,1,"orange"	, 90,"10"	,7,3,2,0
					If Not Player(CurrentPlayer).HOLLYtargets.IsFull Then
						pupFlashHollyLetterL
					End If
					Check_Holly
				Else
					Player(CurrentPlayer).BonusHolly = Player(CurrentPlayer).BonusHolly + bonus_holly_no_advance
				End If
			Else
				Player(CurrentPlayer).BonusHolly = Player(CurrentPlayer).BonusHolly + bonus_holly_no_advance
			End If

			If ModeRunning = HansGruberMode Then
				'If Lampstate(32)=1 Then
				If bTargetL1Ready=True Then
					bTargetL1Ready = False
					ChangeLamp 32,0,"orange"	, 90,"10"	,7,3,2,0	' change it and blink extra added
					TargetL1Reset.Interval = 3000
					TargetL1Reset.Enabled = True
					Player(CurrentPlayer).HansGruberModeProgress = Player(CurrentPlayer).HansGruberModeProgress + 1
					Check_Hans
				End If
			End If

		Case 2   'TargetL2
			UCFlashBlue
			HollyTargetSounds
			DOF 109,DOFPulse
			If Not bGameInPlay Then Exit Sub
			BLS 33,33,4,2,2,0
			AddScore score_hollytargets

			If ModeRunning="" Then

				If Player(CurrentPlayer).NakatomiMBAvailable Then
					If (Not Player(CurrentPlayer).TowerLock) And (Not Player(CurrentPlayer).NakatomiTargetHitR) Then
						Player(CurrentPlayer).NakatomiTargetHitR = True
						Player(CurrentPlayer).BonusMultiballs = _
						Player(CurrentPlayer).BonusMultiballs + bonus_mball_advance
