'Handles the flipper press left or right for the attract mode
Sub AttractFlipperCall(keycode)
	If keycode = LeftFlipperKey Then 
		AttractNext -1
	ElseIf keycode = RightFlipperKey Then 
		AttractNext 1
	End If
End Sub

Sub AttractNext(PageIndex)               
    WriteToLog "PuP", "AttractNext Page Index: " & PageIndex

    if pInAttract=false Then Exit Sub      'You should first check that table is still in Attract mode incase of future triggers or manually skipped.    
    
    if PageIndex=0 Then
           AttractCurIndex=AttractCurIndex+1
    else    'we are forcing page prob because of flipper key next/prior
        TriggerStopIndex AttractTrigIndex 
        AttractCurIndex=AttractCurIndex+PageIndex  
    end if
WriteToLog "PuP", "AttractNext: AttractCurIndex " & AttractCurIndex

    if AttractCurIndex>4 then AttractCurIndex=0   'set this 3 value to MAX pages in case above/attract!
    if AttractCurIndex<0 then Attractcurindex=4  'safety in case of too many prior keypresses.

    Select Case AttractCurIndex
        Case 0 pupDMDDisplay "attract"," DETECTIVE LIEUTENANT ^ " & HighScoreName(1) & " ^ " & FormatNumber(HighScore(1),0) & " ","HSBackground2.mp4",7,0,10:AttractTrigIndex=TriggerScript(5100,"AttractNext(0)")
        Case 1 pupDMDDisplay "attract"," BEAT COP ^ "  & HighScoreName(2) & " ^ " & FormatNumber(HighScore(2),0) & " ","HSBackground3.mp4",6,0,10:AttractTrigIndex=TriggerScript(5100,"AttractNext(0)")
		Case 2 pupDMDDisplay "attract"," YIPPIE KI YAY CHAMPION ^ " & HighScoreName(0) & " ^ " & FormatNumber(HighScore(0),0) & " ","HSBackground1.mp4",6,0,10:AttractTrigIndex=TriggerScript(5100,"AttractNext(0)")
		Case 3 
				HideIScoredLeaderboard
				ShowEndGameScore
				AttractTrigIndex=TriggerScript(5100,"AttractNext(0)")
		Case 4 
				HideEndGameScore
			If IScoredEnabled = false Then
				AttractTrigIndex=TriggerScript(100,"AttractNext(0)")
				'AttractNext(0)
			Else
				ShowIScoredLeaderboard:AttractTrigIndex=TriggerScript(5100,"AttractNext(0)")
			End If
    End Select
End Sub
