Function FormatScore(nScore)
	' The VBScript FormatNumber has the drawback of using the operating system's
	' regional settings, so use this to add thousands separators
	Dim i
	Dim sScore, sFormattedScore
	Const nMaxScoreLength = 13
	sScore = CStr(nScore)
	sFormattedScore = ""
	Dim nDigitCount
	Dim sDigit
	nDigitCount = Len(sScore)
	' If score is > 10B, don't add commas or the score won't fit on the display
	If nDigitCount > 10 Then
		FormatScore = sScore
		Exit Function
	End If
	For i = 1 to nDigitCount
		sDigit = Mid(sScore, (1 + (nDigitCount - i)), 1)
		If (i > 1) and (1 = (i mod 3)) Then
			sFormattedScore = sFormattedScore & "," & sDigit
		Else
			sFormattedScore = sFormattedScore & sDigit
		End If
	Next
	FormatScore = StrReverse(sFormattedScore)

	If len(FormatScore) > nMaxScoreLength Then
		FormatScore = Left(FormatScore, nMaxScoreLength)
	End If
End Function

