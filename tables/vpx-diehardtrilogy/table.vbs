		case 4 :
			If bulletcolor1 < 178 then bulletcolor1 = bulletcolor1 + 1
			If bulletcolor1 > 178 then bulletcolor1 = bulletcolor1 - 1
			If bulletcolor2 < 12 then bulletcolor2 = bulletcolor2 + 1
			If bulletcolor2 > 12 then bulletcolor2 = bulletcolor2 - 1
			If bulletcolor3 < 178 then bulletcolor3 = bulletcolor3 + 1
			If bulletcolor3 > 178 then bulletcolor3 = bulletcolor3 - 1
	End Select


	lightCtrl.LightColor lights(20), rgb(bulletcolor1,bulletcolor2,bulletcolor3)
