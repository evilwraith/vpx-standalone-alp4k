Sub ResetForNewBall
	WriteToLog "ResetForNewBall", ""

	' Bullet Update
	If Player(CurrentPlayer).Collected_Bullets < MinimumBullets Then
		Player(CurrentPlayer).Collected_Bullets = MinimumBullets
	End If
	BulletsHit(1)=0 
	BulletsHit(2)=0
	BulletsHit(3)=0
	BulletsHit(4)=0
	BulletsHit(5)=0

	' Tilt reset
	Tilt = 0
	MechTilt = 0
	TiltSensitivity = 5
	bTilted = False
	bDieHarderFailed = False
	bMechTiltJustHit = False

	'Reset drop Targets
	SolDTBank123 True
	targetsdown = 0

	' Game state update
	PointMultiplier=1
	MultiplierTimeLeft = 0
	ModeTimeLeft = 0
	bPlayfieldValid = False
	bBulletsHidden = False
	AddBallAvailable = False
	AddTimeAvailable = False
	If Player(CurrentPlayer).KarlBonus Then
		Player(CurrentPlayer).BonusMultiplier = 6
	ElseIf Player(CurrentPlayer).BonusXHeld Then
		Player(CurrentPlayer).BonusXHeld = False
	Else
		Player(CurrentPlayer).BonusMultiplier = 1
	End If

	' Light state update
	UpdateLightsAll

	' Toys Update
	TaxiPos = Player(CurrentPlayer).ParkLocks
	If (Player(CurrentPlayer).VaultMultiballReady _
	Or (Player(CurrentPlayer).vaultTargetCount >= 2)) _
	And (not bVaultDoorOpen) Then
		OpenVaultDoor
	Elseif (Not Player(CurrentPlayer).VaultMultiballReady) _
	And (Player(CurrentPlayer).vaultTargetCount < 2) _
	And bVaultDoorOpen Then
		CloseVaultDoor
	End If
	If Player(CurrentPlayer).VaultMultiballReady  Then
		' TODO: Add lights to indicate vault multiball is ready
	End If

	InitSkillShot BallInPlay ' start skillshot

End Sub

