dim MobileOffscreenRight, MobileOffscreenLeft,MobileFacingPos, HitFacingLeftR, HitFacingLeftL, HitFacingRightR, HitFacingRightL

HitFacingLeftR = 840
HitFacingLeftL = 960
HitFacingRightR = 1000
HitFacingRightL = 1120

MobileOffscreenRight = 2200 ' offscreen right
MobileOffscreenLeft = -300  ' offscreen left
MobileFacingPos = "Left" ' default to Left but value will be Left or Right in code.

dim mXpos:mxPos = 2200
dim CatchSkillShot:CatchSkillShot = False ' used for keydown to capture the skillshot

'**********************************************************
'* InitSkillShot is used to setup the skill shot visuals And
'* code
'* ballNumber represents the current ball of the urer
'**********************************************************

dim skillShotBallNumber
Sub InitSkillShot(ballNumber)
	WriteToLog "PUP", "InitSkillShot "  & ballNumber
	pDMDSetHUD 0
	pDMDSetPage(pDMDBlank)
	pDMDSetPage(pSkillshot)
	pDMDStopBackLoop
	PupEvent 135
	PupEvent 136 'Show skillshot video
	CatchSkillShot = True
	StartSkillShot ballNumber
	skillShotBallNumber = ballNumber
End Sub

Sub StartSkillShot(ballNumber)
	WriteToLog "PUP", "StartSkillShot " & ballNumber 

	pDMDLabelSet  "SkillShotPlayer", "PLAYER " & CurrentPlayer & " UP"
	pDMDLabelShow "HandGun"
	pDMDLabelShow "SnowmobileFacingLeft"
	pDMDLabelShow "SnowmobileFacingRight"

	mxPos = MobileOffscreenRight ' reset mXpos

	Select Case ballNumber
		Case 1     
			MobileMovement.Interval = 30
		Case 2   
			MobileMovement.Interval = 20
		Case 3   
			MobileMovement.Interval = 16
		Case Else  
			MobileMovement.Interval = 16 ' make any other ball...4 or 5 the top speed
	End Select

	MobileMovement.enabled = True
End Sub 

'**********************************************************
'*
'*	This timer is used to animate the skillshot snowmobile
'*
'**********************************************************

Sub MobileMovement_Timer
	
    dim tmpPos

	if MobileFacingPos = "Left" Then
		'mxPos = mxPos - (20 + rnd(20)) ' move from right to left   
		mxPos = mxPos - 40 ' move from right to left
		tmpPos = mxPos
		if abs(tmpPos)<3 then tmpPos=3
		'WriteToLog "PUP", "MobileMovement_Timer tmpPos "  & tmpPos

		if (mXpos < HitFacingLeftL AND mXpos > HitFacingLeftR) Then
			'red
			pDMDLabelSet "SnowmobileFacingLeft", "Skillshot\\mobilelred.png"
		Else
			pDMDLabelSet "SnowmobileFacingLeft", "Skillshot\\mobilel.png"
		End If
		
		pDMDLabelSetPos "SnowmobileFacingLeft", tmpPos, 560

		If mxPos =< MobileOffscreenLeft Then
			MobileFacingPos = "Right"
		End If
	End If

	if MobileFacingPos = "Right" Then
		'mxPos = mxPos + (20 + rnd(20)) ' move from right to left    
		mxPos = mxPos + 40 ' move from right to left  
		tmpPos = mxPos
		if abs(tmpPos)<3 then tmpPos=3		
		'WriteToLog "PUP", "MobileMovement_Timer tmpPos "  & tmpPos

		if (mXpos < HitFacingRightL AND mXpos > HitFacingRightR) Then
			pDMDLabelSet "SnowmobileFacingRight", "Skillshot\\mobilerred.png"
		Else
			pDMDLabelSet "SnowmobileFacingRight", "Skillshot\\mobiler.png"	
		End If

		pDMDLabelSetPos "SnowmobileFacingRight", tmpPos, 560

		If mxPos => MobileOffscreenRight Then
			MobileFacingPos = "Left"
		End If
	End If

End Sub



	

'**********************************************************
'*
'*	SkillShotReceived is called by KeyDown to capture the 
'*  player's skillshot and determine if they hit the target
'*
'**********************************************************
Sub SkillShotReceived
	WriteToLog "PUP", "SkillShotReceived" 
	MobileMovement.enabled = False

     WriteToLog "PUP","The current position is " & mXpos

	If MobileFacingPos = "Left" AND (mXpos < HitFacingLeftL AND mXpos > HitFacingLeftR) Then
		WriteToLog "PUP", "SkillShotReceived HIT!"
		SkillShotHit
	ElseIf MobileFacingPos = "Right" AND (mXpos < HitFacingRightL AND mXpos > HitFacingRightR) Then
		WriteToLog "PUP", "SkillShotReceived HIT!"
		SkillShotHit
	Else 
		PuPEvent 137
		HideSnowMobileAndHand
		WriteToLog "PUP", "SkillShotReceived MISS!"
	End If
	
	CatchSkillShot = False
End Sub

'Handles the scoring and the appropriate video for the skillshot
Sub SkillShotHit
	HideSnowMobileAndHand

	Select Case skillShotBallNumber

		Case 1: '1M, 5sec BallSave
			AddScore 1000000
			Start_Ballsave 5000
			PupEvent 138
		Case 2: '2M, 7sec BallSave
			AddScore 2000000
			Start_Ballsave 7000
			PupEvent 146
		Case 3:	'4M, 10sec Ballsave
			AddScore 4000000
			Start_Ballsave 10000
			PupEvent 147
		Case Else: '4M, 10sec Ballsave
			AddScore 4000000
			Start_Ballsave 10000
			PupEvent 147
	End Select
End Sub

