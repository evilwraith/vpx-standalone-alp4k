Dim BulletsHit(5)

Function MinimumBullets()
	Dim nBullets
	nBullets = -1
	If Not Player(CurrentPlayer).HansGruberModeComplete Then nBullets = nBullets + 2
	If Not Player(CurrentPlayer).SimonGruberModeComplete Then nBullets = nBullets + 2
	If Not Player(CurrentPlayer).KarlModeComplete Then nBullets = nBullets + 2
	If Not Player(CurrentPlayer).KatyaModeComplete Then nBullets = nBullets + 2
	If Not Player(CurrentPlayer).ColStuartModeComplete Then nBullets = nBullets + 2
	If nBullets < 1 Then nBullets = 1
	MinimumBullets = nBullets
End Function

