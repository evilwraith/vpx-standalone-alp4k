Sub AwardVaultMystery(nAward)
	Dim nDisplayTime
	If AddTimeAvailable Then
		ModeTimeLeft = ModeTimeLeft + 20000
		nDisplayTime = (ModeTimeLeft \ 1000) - 2
		If ModeRunning = KarlMode Then
			UpdateJohnsHealth
		Else
			ShowModeTimer nDisplayTime
		End If
		AddTimeAvailable = False
		Exit Sub
	End If
	If AddBallAvailable Then
		Start_Ballsave Holly_BallSaverTime
		AddMultiball 1
		AddBallAvailable = False
		Exit Sub
	End If
	Select Case nAward
		Case eMysteryAdvTower
			Player(CurrentPlayer).TowerLock = True
			Player(CurrentPlayer).NakatomiTargetHitL = True
			Player(CurrentPlayer).NakatomiTargetHitR = True
			LockIsLit
			UpdateLightsNakatomi
		Case eMysteryAdvAirplane
			DoThePlaneShake
			Player(CurrentPlayer).AirplaneCaptiveHits = 0
			Player(CurrentPlayer).AirplaneLockLit = True
			UpdateLightsAirplane
		Case eMysteryAdvPark
			Player(CurrentPlayer).ParkLocks = Player(CurrentPlayer).ParkLocks + 1
			TaxiPos = Player(CurrentPlayer).ParkLocks
			ParkMBLocks Player(CurrentPlayer).ParkLocks
			UpdateLightsPark
		Case eMysteryBullets
			Player(CurrentPlayer).Collected_Bullets = 15
			If ModeRunning = "" Then
				ChangeLamp 10,2,"white",130,"110",5,2,2,0
			End If
		Case eMysteryBallSave
			pupHollyComplete
			Start_Ballsave Holly_BallSaverTime
		Case eMysteryBonusX
			Player(CurrentPlayer).BonusMultiplier = Player(CurrentPlayer).BonusMultiplier + 1
		Case eMysteryHoldBonusX
			Player(CurrentPlayer).BonusXHeld = True
		Case eMysteryAdvBumpers
			Player(CurrentPlayer).SuperJets = SuperjetsGoal
		Case eMysteryAdvSpinner
			Player(CurrentPlayer).SuperSpinners = True
		Case eMysteryPlayfieldX
			PlayfieldMultiplierUp
		Case eMysteryAmbush
			Player(CurrentPlayer).Ambush = Player(CurrentPlayer).Ambush + 1
			UpdateLightsLanes
		Case eMysteryPoints
			AddScore score_MysteryPoints
		Case eMysteryLiteEB
			Player(CurrentPlayer).ExtraBallMballAwarded = True
			Player(CurrentPlayer).ExtraBallsLit = Player(CurrentPlayer).ExtraBallsLit + 1
			ExtraBallIsLit
	End Select
End Sub

