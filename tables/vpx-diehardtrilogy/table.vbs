'  The Vault door animation
'*******************************************
Dim bVaultDoorMoving					' True if the vault door should animate
Dim nTimeVaultStartMove					' Timestamp of when the door animation started
Const nTimeToMoveVault = 250			' Ms between closed and open states
Sub OpenVaultDoor ()
	DOF 118,DOFPulse
	l84.state=2
	VaultDoorOpensSounds
	ChangeLamp eInsertVault, 2 ,"blue", 80, "10",1,0,0,0
	If Not bVaultDoorOpen Then
		VaultDoor.isDropped = true
		KickerVault1.Enabled = true
		bVaultDoorOpen = True
		bVaultDoorMoving = True
		nTimeVaultStartMove = GameTime
	End If
End Sub
Sub CloseVaultDoor ()
	DOF 118,DOFPulse
	l84.state=0
	ChangeLamp eInsertVault, 0 ,"green", 120, "10",1,0,0,0
	If bVaultDoorOpen Then
		VaultDoor.isDropped = false
		KickerVault1.Enabled = true 'if the ball gets in somehow, does have to ignore the event for score tho
		bVaultDoorOpen = False
		bVaultDoorMoving = True
		nTimeVaultStartMove = GameTime
	End If
End Sub
Sub	AnimateVaultDoor
	dim dDoorAngle, z
	If bVaultDoorOpen Then
		If GameTime - nTimeVaultStartMove >= nTimeToMoveVault Then
			bVaultDoorMoving = False
			z = 55
		Else
			dDoorAngle = 55 * ((GameTime - nTimeVaultStartMove) / nTimeToMoveVault)
			z = dDoorAngle
		End If
	Else
		If GameTime - nTimeVaultStartMove >= nTimeToMoveVault Then
			bVaultDoorMoving = False
			z = 0
		Else
			dDoorAngle = 55 * (1 - ((GameTime - nTimeVaultStartMove) / nTimeToMoveVault))
			z = dDoorAngle
		End If
	End If

	Dim el: For Each el in BP_pVaultDoor: el.RotZ = z: Next
End Sub

Const eMysteryAdvTower = 0 : Const eMysteryAdvAirplane = 1 : Const eMysteryAdvPark = 2
Const eMysteryBullets = 3 : Const eMysteryBallSave = 4 : Const eMysteryBonusX = 5
Const eMysteryHoldBonusX = 6 : Const eMysteryAdvSpinner = 7 : Const eMysteryAdvBumpers = 8
Const eMysteryPlayfieldX = 9 : Const eMysteryAmbush = 10 : Const eMysteryPoints = 11
Const eMysteryJoke1 = 12 : Const eMysteryJoke2 = 12 : Const eMysteryAddTime = 13
Const eMysteryAddBall = 14 : Const eMysteryLiteEB = 15
Dim aVaultAwards()
Dim nVaultAwardCount
Sub InitVaultMystery
	MysteryScrollSounds
	Dim i, nModesComplete, nMballsFailed
	Redim aVaultAwards(12)
	Player(CurrentPlayer).vaultTargetCount = 0

	' points are always available
	nVaultAwardCount = 0
	aVaultAwards(nVaultAwardCount) = eMysteryPoints
	nVaultAwardCount = nVaultAwardCount + 1
	
	If Player(CurrentPlayer).NakatomiMBAvailable _
	And (Not Player(CurrentPlayer).TowerLock) Then
		aVaultAwards(nVaultAwardCount) = eMysteryAdvTower
		nVaultAwardCount = nVaultAwardCount + 1		
	End If

	If Player(CurrentPlayer).AirplaneMBAvailable _
	And (Not Player(CurrentPlayer).AirplaneLockLit) Then
		aVaultAwards(nVaultAwardCount) = eMysteryAdvAirplane
		nVaultAwardCount = nVaultAwardCount + 1		
	End If

	If Player(CurrentPlayer).ParkMBAvailable _
	And (Player(CurrentPlayer).ParkLocks < 2) Then
		aVaultAwards(nVaultAwardCount) = eMysteryAdvPark
		nVaultAwardCount = nVaultAwardCount + 1		
	End If

	nModesComplete = 0
	For each i in Array(HansGruberMode, KatyaMode, KarlMode, _
						ColStuartMode, SimonGruberMode)
		If isDefeated(i) Then
			nModesComplete = nModesComplete + 1
		End If
	Next
	If nModesComplete < 5 and "" = ModeRunning _
	and Player(CurrentPlayer).Collected_Bullets < 13 Then
		aVaultAwards(nVaultAwardCount) = eMysteryBullets
		nVaultAwardCount = nVaultAwardCount + 1		
	End If

	If nTimeBallSave < 1 And ModeRunning <> "TowerMB" _
	And ModeRunning <> "AirplaneMB" And ModeRunning <> "ParkMB" Then
		aVaultAwards(nVaultAwardCount) = eMysteryBallSave
		nVaultAwardCount = nVaultAwardCount + 1		
	End If

	If Player(CurrentPlayer).BonusMultiplier < 6 Then
		aVaultAwards(nVaultAwardCount) = eMysteryBonusX
		nVaultAwardCount = nVaultAwardCount + 1		
	End If

	If (Not Player(CurrentPlayer).BonusXHeld) And _
	(Not Player(CurrentPlayer).KarlBonus) Then
		aVaultAwards(nVaultAwardCount) = eMysteryHoldBonusX
		nVaultAwardCount = nVaultAwardCount + 1		
	End If

	If Player(CurrentPlayer).SuperJets < SuperjetsGoal Then
		aVaultAwards(nVaultAwardCount) = eMysteryAdvBumpers
		nVaultAwardCount = nVaultAwardCount + 1	
	End If

	If Not Player(CurrentPlayer).SuperSpinners Then
		aVaultAwards(nVaultAwardCount) = eMysteryAdvSpinner
		nVaultAwardCount = nVaultAwardCount + 1		
	End If

	If ((Player(CurrentPlayer).StuartBonus) And (PointMultiplier < 5)) _
	or (PointMultiplier < 3) Then
		aVaultAwards(nVaultAwardCount) = eMysteryPlayfieldX
		nVaultAwardCount = nVaultAwardCount + 1		
	End If

	If Player(CurrentPlayer).Ambush < 4 Then
		aVaultAwards(nVaultAwardCount) = eMysteryAmbush
		nVaultAwardCount = nVaultAwardCount + 1		
	End If

	' Extra ball is only available from the mystery if it's locked out from multiballs
	nMballsFailed = 0
	If (Not Player(CurrentPlayer).NakatomiMBAvailable) and _
	(Not Player(CurrentPlayer).NakatomiSuperCollected) Then
		nMballsFailed = nMballsFailed + 1
	End If
	If (Not Player(CurrentPlayer).AirplaneMBAvailable) and _
	(Not Player(CurrentPlayer).AirplaneMBstage2) Then
		nMballsFailed = nMballsFailed + 1
	End If
	If (Not Player(CurrentPlayer).ParkMBAvailable) and _
	(Not Player(CurrentPlayer).ParkSuperCollected) Then
		nMballsFailed = nMballsFailed + 1
	End If
	If (nMballsFailed > 1) And (Not Player(CurrentPlayer).ExtraBallMballAwarded) Then
		aVaultAwards(nVaultAwardCount) = eMysteryLiteEB
		nVaultAwardCount = nVaultAwardCount + 1		
	End If

	Redim Preserve aVaultAwards(nVaultAwardCount - 1)
	RandomShuffleArray aVaultAwards
End Sub

