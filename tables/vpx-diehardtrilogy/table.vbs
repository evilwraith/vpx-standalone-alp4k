Sub SetLightColor ( Lightnr, NewColor ) ' important to use this there has to be 3 items in massassign    clight,light,addictive primitive as the 3rd
		If IsObject(Lights(Lightnr)) Then
			dim rgbColor
			Select Case NewColor
				Case "green"
					rgbColor = RGB(11, 177, 11) 
				Case "yellow"
					rgbColor = RGB(166,166,11) 
				Case "orange"
					rgbColor = RGB(222,120,11) 
				Case "red"
					rgbColor = RGB(200,11,11)
				Case "blue"
					rgbColor = RGB(33,77,255)  
				Case "purple"
					rgbColor = RGB(155,11,155)  
				Case "darkblue"
					rgbColor = RGB(11,11,234)  
				Case "white"
					rgbColor = RGB(225,230,240)  
				Case "whiteLED"
					rgbColor = RGB(GIdefault1,GIdefault2,GIdefault3)
			End Select

		If Lightnr > 11 And lightnr < 16 Then
			Select Case ModeRunning
				Case "HansMode"		: rgbColor = rgb(GI_Hans1,GI_Hans2,GI_Hans3)
						If diehardArrayIndex = 0 Then rgbColor = RGB(225,230,240) 
				Case "SimonMode"	: rgbColor = rgb(GI_simon1,gI_simon2,gI_simon3)
						If diehardArrayIndex = 0 Then rgbColor = RGB(225,230,240) 
				Case "StuartMode"	: rgbColor = rgb(GI_Stuart1,GI_Stuart2,GI_Stuart3)
						If diehardArrayIndex = 0 Then rgbColor = RGB(225,230,240) 
				Case "KatyaMode"	: rgbColor = rgb(GI_Katja1,GI_Katja2,GI_Katja3)
						If diehardArrayIndex = 0 Then rgbColor = RGB(225,230,240) 
				Case "KarlMode"		: rgbColor = rgb(GI_Karl1,GI_Karl2,GI_Karl3)
						If diehardArrayIndex = 0 Then rgbColor = RGB(225,230,240) 
			End Select

		End If
		If Lightnr > 19 And lightnr < 25 Then
			Select Case ModeRunning
				Case "HansMode"		: rgbColor = rgb(GI_Hans1,GI_Hans2,GI_Hans3)
				Case "SimonMode"	: rgbColor = rgb(GI_simon1,gI_simon2,gI_simon3)
				Case "StuartMode"	: rgbColor = rgb(GI_Stuart1,GI_Stuart2,GI_Stuart3)
				Case "KatyaMode"	: rgbColor = rgb(GI_Katja1,GI_Katja2,GI_Katja3)
				Case "KarlMode"		: rgbColor = rgb(GI_Karl1,GI_Karl2,GI_Karl3)
			End Select
		End If

		lightCtrl.LightColor Lights(Lightnr), rgbColor

	End If
End Sub

