Sub Blink_ComboBullets
	Dim nBulletsBefore
	If BulletsHit(1) = 0 Then ChangeLamp 50,2,"white"	, 150,"110"	,4,2,2,0	
	If BulletsHit(2) = 0 Then ChangeLamp 51,2,"white"	, 150,"110"	,4,2,2,0	
	If BulletsHit(3) = 0 Then ChangeLamp 53,2,"white"	, 150,"110"	,4,2,2,0	
	If BulletsHit(4) = 0 Then ChangeLamp 54,2,"white"	, 150,"110"	,4,2,2,0	
	If BulletsHit(5) = 0 Then ChangeLamp 55,2,"white"	, 150,"110"	,4,2,2,0

	nBulletsBefore = Player(CurrentPlayer).Collected_Bullets
	Player(CurrentPlayer).Collected_Bullets = Player(CurrentPlayer).Collected_Bullets + BulletsHit(1)+BulletsHit(2)+BulletsHit(3)+BulletsHit(4)+BulletsHit(5)

	If Player(CurrentPlayer).Collected_Bullets => 15 Then
		Player(CurrentPlayer).Collected_Bullets = 15
		ChangeLamp 50,0,"orange"	, 100,"110"	,10,5,5,0	
		ChangeLamp 51,0,"orange"	, 100,"110"	,10,5,5,0	
		ChangeLamp 53,0,"orange"	, 100,"110"	,10,5,5,0	
		ChangeLamp 54,0,"orange"	, 100,"110"	,10,5,5,0	
		ChangeLamp 55,0,"orange"	, 100,"110"	,10,5,5,0	
	End If

	If Player(CurrentPlayer).Collected_Bullets > nBulletsBefore Then
		Player(CurrentPlayer).BonusBullets = Player(CurrentPlayer).BonusBullets + _
			(bonus_bullet_advanced * (Player(CurrentPlayer).Collected_Bullets - nBulletsBefore))
		BulletCollectedSounds
	Else
		Player(CurrentPlayer).BonusBullets = Player(CurrentPlayer).BonusBullets + bonus_bullet_no_advance
	End If

	If Player(CurrentPlayer).Collected_Bullets = 15 And ModeRunning = "" Then
		ChangeLamp 10,2,"white",130,"110",5,2,2,0
	End If


	If BulletsHit(1)+BulletsHit(2)+BulletsHit(3)+BulletsHit(4)+BulletsHit(5) = 5 Then
		ChangeLamp 50,0,"green"	, 100,"110"	,5,2,2,0	
		ChangeLamp 51,0,"green"	, 100,"110"	,5,2,2,0
		ChangeLamp 53,0,"green"	, 100,"110"	,5,2,2,0
		ChangeLamp 54,0,"green"	, 100,"110"	,5,2,2,0
		ChangeLamp 55,0,"green"	, 100,"110"	,5,2,2,0
		BulletCollector.enabled = False
		BulletCollector.interval = 1000
		BulletCollector.enabled = True
	End If
End Sub


