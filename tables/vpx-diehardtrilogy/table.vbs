Sub NakatomiShotHit(nShot)
	Dim i, bValidShot, nShotCount

	bValidShot = False
	For Each i in Array(eShotLoopLeft, eShotRampLeft, eShotRampRight, _
						eShotLoopUpper, eShotLoopRight)
		If i = nShot Then
			If Player(CurrentPlayer).NakatomiStage2 Then
				If Player(CurrentPlayer).NakatomiJPsHit(nShot) < 2 Then
					bValidShot = True
				End If
			ElseIf Player(CurrentPlayer).NakatomiJPsHit(nShot) < 1 Then
				bValidShot = True
			End If
		End If
	Next

	If bValidShot Then
		WriteToLog "NakatomiShotHit", asShotNames(nShot) & " hit, shot was lit for jackpot"
		Player(CurrentPlayer).NakatomiJPsHit(nShot) = Player(CurrentPlayer).NakatomiJPsHit(nShot) + 1

		lightCtrl.AddTableLightSeq "TEST", lSeqGItest1
		lightCtrl.PulseWithColor f142, rgb( 222,15,15) ,1 : DOF 142, DOFPulse
		lightCtrl.PulseWithColor f143, rgb( 222,15,15) ,1 ': DOF 143, DOFPulse
		lightCtrl.PulseWithColor f144, rgb( 222,15,15) ,1 ': DOF 144, DOFPulse
		lightCtrl.PulseWithColor f145, rgb( 222,15,15) ,1 ': DOF 145, DOFPulse
		lightCtrl.PulseWithColor f146, rgb( 222,15,15) ,1 ': DOF 146, DOFPulse
		lightCtrl.PulseWithColor f147, rgb( 222,15,15) ,1 : DOF 147, DOFPulse
		

		If Player(CurrentPlayer).NakatomiStage2 Then
			AddScore score_Nakatomi_JP * 2
			PUP_Jackpot score_Nakatomi_JP * 2 'call jackpot video  Super Jackpot???
			If Player(CurrentPlayer).NakatomiJPsHit(nShot) >= 2 Then
				ChangeLampState anInsertsForShot(nShot), 0
			End If
		Else
			ChangeLampState anInsertsForShot(nShot), 0
			AddScore score_Nakatomi_JP
			PUP_Jackpot score_Nakatomi_JP 'Call Jackpot video
		End If
	

		nShotCount = 0
		For Each i in Array(eShotLoopLeft, eShotRampLeft, eShotRampRight, _
							eShotLoopUpper, eShotLoopRight)
			nShotCount = nShotCount + Player(CurrentPlayer).NakatomiJPsHit(i)
		Next
		WriteToLog "NakatomiShotHit", nShotCount & " jackpots hit"
		If (Player(CurrentPlayer).NakatomiStage2 And (nShotCount >= 10)) _
		Or ((Not Player(CurrentPlayer).NakatomiStage2) And (nShotCount >= 5)) Then
			WriteToLog "NakatomiShotHit", "Lighting super jackpot"
			LockKicker1.enabled=True
			LockKicker2.enabled=False
			LockKicker3.enabled=False
			Player(CurrentPlayer).NakatomiSuperLit = True
			
			ChangeLamp eInsertNakatomiLockLit,  2,"blue" , 120,"10"     ,5,2,2,1
			ModeTimeLeft = 23000
			ShowModeTimer 20
			PupShowGameMessage "SUPER JACKPOT IS LIT!"
		End If
	Else
		WriteToLog "NakatomiShotHit", asShotNames(nShot) & " hit, shot was not lit"
	End If
End Sub

