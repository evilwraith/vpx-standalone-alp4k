Sub DTAction(switchid)    'Called when target actually drops
	Select Case switchid
		Case 1:
			DOF 108,DOFPulse
			If Not bGameInPlay Then Exit Sub
			Addscore score_DropsHit
			If (Not Player(CurrentPlayer).StuartBonus) And (PointMultiplier < 3) Then
				BLinkPFmultiplier TargetsDown,TargetsDown or 1
				TargetsDown=TargetsDown or 1
			Elseif PointMultiplier < 5 Then
				BLinkPFmultiplier TargetsDown,TargetsDown or 1
				TargetsDown=TargetsDown or 1
			End If
			DropTargetRandomSounds
		Case 2:
			DOF 108,DOFPulse
			If Not bGameInPlay Then Exit Sub
			Addscore score_DropsHit
			If (Not Player(CurrentPlayer).StuartBonus) And (PointMultiplier < 3) Then
				BLinkPFmultiplier TargetsDown,TargetsDown or 2
				TargetsDown=TargetsDown or 2
			Elseif PointMultiplier < 5 Then
				BLinkPFmultiplier TargetsDown,TargetsDown or 2
				TargetsDown=TargetsDown or 2
			End If
			DropTargetRandomSounds
		Case 3:
			DOF 108,DOFPulse
			If Not bGameInPlay Then Exit Sub
			Addscore score_DropsHit
			If (Not Player(CurrentPlayer).StuartBonus) And (PointMultiplier < 3) Then
				BLinkPFmultiplier TargetsDown,TargetsDown or 4
				TargetsDown=TargetsDown or 4
			Elseif PointMultiplier < 5 Then
				BLinkPFmultiplier TargetsDown,TargetsDown or 4
				TargetsDown=TargetsDown or 4
			End If
			DropTargetRandomSounds
	End Select
End Sub


Sub BLinkPFmultiplier( nr1,nr2)
	If nr2 > nr1 Then
		Select Case nr2
			Case 1,2,4 : ChangeLamp 18,2,"yellow",200,"10", 5,2,2,0
			Case 3,5,6 : ChangeLamp 18,2,"yellow",120,"10", 5,2,2,0
			Case 	 7 : ChangeLamp 18,2,"green",80,"10110100", 5,2,2,0
		End Select	
	Else
		BLS 18,18,5,2,2,0
	End If
End Sub




Sub PlayfieldMultiplierUp
	TargetsDown=0
	ChangeLamp 18,0,"red",80,"10", 10,2,2,0
	ResetTopBanks.enabled=True
	Dim bUpdate
	If Player(CurrentPlayer).StuartBonus And (PointMultiplier < 5) Then
		PointMultiplier = PointMultiplier + 1
		bUpdate = True
	Elseif PointMultiplier < 3 Then
		PointMultiplier = PointMultiplier + 1
		bUpdate = True
	Else
		bUpdate = False
	End If

	' Reset the timer even if the multiplier is maxed
	MultiplierTimeLeft = PlayfieldXTime

	If bUpdate Then
		Select Case PointMultiplier
			Case 2 : PuP_2x
			Case 3 : PuP_3x
			Case 4 : PuP_4x
			Case 5 : PuP_5x
		End Select
	End If

'	ChangeLamp 10+PointMultiplier,1,"white",90,"10", 10,7,5,0

