Sub pUpdateScores  'call this ONLY on timer 300ms is good enough
	
	if pDMDCurPage <> pScores then Exit Sub
	'PuPlayer.LabelSet pDMD,"Credits","CREDITS " & ""& 3 ,1,"" '3 is num of credits

	'This sets the Ball to the Current ball 
	PuPlayer.LabelSet pDMD,"CurrentBall","BALL " & BallInPlay & " ",1,"" ' different font from number...so diff label
	
	If (pupHideCurrentScore = False) Then
		'set the big score to current player's active score, and visible
		PuPlayer.LabelSet pDMD,"CurScore"," " & FormatScore(Player(CurrentPlayer).Score) & " ",1,"" 'set visible
	End If

	PuPlayer.LabelSet pDMD,"CurScore1","" & FormatScore(Player(1).Score),1,""
	if PlayersPlayingGame > 1 Then PuPlayer.LabelSet pDMD,"CurScore2","" & FormatScore(Player(2).Score),1,""
	if PlayersPlayingGame > 2 Then PuPlayer.LabelSet pDMD,"CurScore3","" & FormatScore(Player(3).Score),1,""
	if PlayersPlayingGame > 3 Then PuPlayer.LabelSet pDMD,"CurScore4","" & FormatScore(Player(4).Score),1,""


	'add check for bullets, if bullets are there then show the appropriate bullets...if not ensure they are off
	If Shown_Bullets < Player(CurrentPlayer).Collected_Bullets Then Shown_Bullets = Shown_Bullets + 1
	If Shown_Bullets > Player(CurrentPlayer).Collected_Bullets Then Shown_Bullets = Shown_Bullets - 1
	If Shown_Bullets > 0 Then
		ShowBullets Shown_Bullets
		bBulletsHidden = False
	ElseIf Shown_Bullets = 0 Then
		HideBullets
	End If

end Sub
