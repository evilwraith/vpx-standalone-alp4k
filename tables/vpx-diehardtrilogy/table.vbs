Sub UpdateKarlsHealth
    WriteToLog "PUP", "UpdateKarlsHealth"
    pupKarlHealth = 12 - Int(KarlHits * 0.12)
    if pupKarlHealth <= 0 Then exit Sub
    PuPlayer.LabelSet pDMD,"KarlHealthLabel", "Karl\\karl" & pupKarlHealth & ".png" ,1,""
	PupEvent 102 ' play random fight video
End Sub

Sub UpdateJohnsHealth
    WriteToLog "PUP", "UpdateJohnsHealth"
	If Player(CurrentPlayer).HansBonus Then
		pupJohnHealth = Int((ModeTimeLeft + 9999) / 10000)
	Else
		pupJohnHealth = Int((ModeTimeLeft + 7499) / 7500)
	End If
	If pupJohnHealth > 12 then pupJohnHealth = 12
    if pupJohnHealth = 0 Then exit Sub
    PuPlayer.LabelSet pDMD,"JohnHealthLabel", "Karl\\john" & pupJohnHealth & ".png" ,1,""
	If pupJohnHealth < pupJohnPreviousHealth Then
		WriteToLog "PUP", "John's health changed from " & pupJohnPreviousHealth & " to " & pupJohnHealth
		pupJohnPreviousHealth = pupJohnHealth
		PupEvent 102 ' play random fight video
	End If
End Sub


