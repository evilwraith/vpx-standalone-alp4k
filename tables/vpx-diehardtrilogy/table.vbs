'#            Stuart Mode
'# Time: 75 s
'# Obj: Hit 6 lit shots. If you have hit 0 or an even number of shots, all bullets
'# are lit unless that shot has been hit during the mode. Otherwise, only the most
'# recent bullet hit will be lit.
'# BONUS: Unlock 4X and 5X playfield scoring
'###########################################################

Const nStuartShotsToComplete = 6
Dim nStuartLastShot

'********************************************
' Start Stuart Mode
'********************************************
Sub StartStuartMode()
	Dim i
	WriteToLog "=================", "StartStuartMode "
	ModeRunning = ColStuartMode
	if (Player(CurrentPlayer).vaultTargetCount < 2) _
	And bVaultDoorOpen Then
		CloseVaultDoor
	End If
	UpdateLightsVault
	Player(CurrentPlayer).ColStuartModeProgress = 0
	Player(CurrentPlayer).ColStuartModeShotsHit.Clear
	nStuartLastShot = eShotNone
	For Each i in Array(eInsertBulletLoopLeft, eInsertBulletLoopRight, eInsertBulletLoopUpper, _
		eInsertBulletRampRight, eInsertBulletRampLeft)
		ChangeLamp i, 2 ,"red", 200, "10",1,0,0,0
	Next
	ChangeLamp eInsertModeStuart, 2, "red", 150, "10",0,0,0,0
	nVillainScore = 500000
	If Player(CurrentPlayer).HansBonus Then
		ModeTimeLeft = 103000
	Else
		ModeTimeLeft = 78000
	End If
	AddTimeAvailable = True
	ShowModeTimer 75
	PlayColStuartVillainMode
	pupChangeDMDBackground 2 ' Set Background to 2 for Die Hard 2
	PupShowGameMessage "HIT YELLOW SHOTS - " & nStuartShotsToComplete & " LEFT"
End Sub

Sub StuartShotHit(nShot)
	Dim i, nProgress, bAwarded, sText

	WriteToLog "=================", "StuartShotHit "
	bAwarded = False

	nProgress = Player(CurrentPlayer).ColStuartModeProgress
	If nProgress Mod 2 = 0 Then
		If Not Player(CurrentPlayer).ColStuartModeShotsHit.Contains(nShot) Then
			Player(CurrentPlayer).ColStuartModeProgress = nProgress + 1
			AddScore score_stuart_progress

			lightCtrl.AddTableLightSeq "TEST", lSeqalllights2

			nVillainScore = nVillainScore + score_stuart_progress
			nStuartLastShot = nShot
			For Each i in Array(eShotLoopLeft, eShotRampLeft, eShotRampRight, _
								eShotLoopUpper, eShotLoopRight)
				If nShot = i Then
					ChangeLampState anInsertsForShot(i), 2
				Else
					ChangeLampState anInsertsForShot(i), 0
				End If
			Next
			If nProgress = 4 Then
				sText = " SHOT LEFT"
			Else
				sText = " SHOTS LEFT"
			End If
			PupShowGameMessage "HIT THE " & UCase(asShotNames(nShot)) & " - " & _
				(nStuartShotsToComplete - (nProgress + 1)) & sText
		End If
	ElseIf nShot = nStuartLastShot Then
		Player(CurrentPlayer).ColStuartModeProgress = nProgress + 1
		If Player(CurrentPlayer).ColStuartModeProgress < nStuartShotsToComplete Then
			Player(CurrentPlayer).ColStuartModeShotsHit.Add nShot
			AddScore score_stuart_progress
			nVillainScore = nVillainScore + score_stuart_progress
			nStuartLastShot = nShot
			For Each i in Array(eShotLoopLeft, eShotRampLeft, eShotRampRight, _
								eShotLoopUpper, eShotLoopRight)
				If Not Player(CurrentPlayer).ColStuartModeShotsHit.Contains(i) Then
					ChangeLampState anInsertsForShot(i), 2
				Else
					ChangeLampState anInsertsForShot(i), 0
				End If
			Next
			PupShowGameMessage "HIT YELLOW SHOTS - " & _
				(nStuartShotsToComplete - (nProgress + 1)) & " SHOTS LEFT"
		Else
			AddScore score_stuart_complete
			nVillainScore = nVillainScore + score_stuart_complete
			EndStuartMode True
		End If
	End If
End Sub

