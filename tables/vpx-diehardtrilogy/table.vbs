Sub Check_Karl(shot_type)
    Dim healthBarsBefore, healthBarsAfter
    healthBarsBefore = 12 - Int(KarlHits * 0.12)
    WriteToLog "=================", "Check_Karl(" & shot_type & ")"
    WriteToLog "Check_Karl", "Begin KarlHits = " & KarlHits

	lightCtrl.AddTableLightSeq "TEST", lSeqalllights3

    If shot_type = KarlBumperHit Then
        KarlHits = KarlHits + 5
		AddScore score_karl_progress * 5
		nVillainScore = nVillainScore + (score_karl_progress * 5)
    End If

    If shot_type = KarlSpinnerHit Then
        KarlHits = KarlHits + 1
		AddScore score_karl_progress
		nVillainScore = nVillainScore + score_karl_progress
    End If

    healthBarsAfter = 12 - Int(KarlHits * 0.12)
    If healthBarsAfter < healthBarsBefore then
        UpdateKarlsHealth
    End If
    WriteToLog "Check_Karl", "End KarlHits = " & KarlHits

    If KarlHits >= KarlHealth Then
		AddScore score_karl_complete
		nVillainScore = nVillainScore + score_karl_complete
        EndKarlMode True
	Else
		PupShowGameMessage "HIT THE SPINNERS AND BUMPERS - " & KarlHits & "%"
    End If
End Sub


