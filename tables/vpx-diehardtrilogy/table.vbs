	If TaxiPos=0 Then
		If TaxiCounter > 0 Then TaxiCounter=TaxiCounter-1
		If TaxiCounter = 0 Then Taxipos = 4
	End If
	If TaxiPos=1 Then
		If TaxiCounter < 150 Then TaxiCounter=TaxiCounter+1
		If TaxiCounter > 150 Then TaxiCounter=TaxiCounter-1
		If TaxiCounter = 150 Then Taxipos = 5
	End If
	If TaxiPos=2 Then
		If TaxiCounter < 300 Then TaxiCounter=TaxiCounter+1
		If TaxiCounter > 300 Then TaxiCounter=TaxiCounter-1
		If TaxiCounter = 300 Then Taxipos = 6
	End If
	If TaxiPos=3 Then
		If TaxiCounter < 450 Then TaxiCounter=TaxiCounter+1
		If TaxiCounter = 450 Then Taxipos = 7
	End If
	Dim el
	If TaxiCounter <> TaxiOldPos Then 
		TaxiOldPos = TaxiCounter 
		lightctrl.pulse f144,1 : DOF 144, DOFPulse
		Bm_CabP.blenddisablelighting = 2
		For Each el in BP_CabP
			el.x = 866.5 - TaxiCounter*0.95866667
			el.y = 146.2 + TaxiCounter*0.29066667
		Next
		If MirrorEnabled = 1 Then
			mBM_CabP.transx = 866.5 - TaxiCounter*0.95866667
			mBM_CabP.transy = -146.2 - TaxiCounter*0.29066667
			mBM_CabP.transz = 200 - tan(mSlope) * -(mBM_CabP.transy + 146.2)
		End If
	Else
		If TaxiDOFOn = True Then
			Bm_CabP.blenddisablelighting = 1
			DOF 117,DOFOff
			SoundRailMotor 0
			TaxiDOFOn = False
'			debug.print "end taxicontrol"
		End If
	End If
End Sub

