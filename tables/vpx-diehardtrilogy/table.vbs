' mirrored balls by iaakki
Dim MBArray
MBArray = Array(pMBall1, pMBall2, pMBall3, pMBall4, pMBall5)
dim mSlope ', safex, safey, safez
mSlope = 6 * 3.1416 / 180

sub updateMirroredBalls
	dim i
	For i = 0 to uBound(MBArray) 
		if gBOT(i+1).y < 1800 and gBOT(i+1).z > 0 then
			MBArray(i).visible = true
			MBArray(i).x = gBOT(i+1).x
			MBArray(i).y = -gBOT(i+1).y
			MBArray(i).z = 25 + gBOT(i+1).z + tan(mSlope) * -gBOT(i+1).y
		Else
			MBArray(i).visible = false
		end if
	Next
end Sub


'************** Nailbuster TriggerScript Code, Wizball's revision
' create a timer in table named exactly pTriggerScript
' set interval on timer to 50 ms (not enabled on startup)
' 
'  supports an unlimited amount of timers
'
'   usage:    TriggerScript <ms>, "vbcode to execute"
'
'   simpletest:  TriggerScript 3500,"MsgBox 1234"   'will show a dialog 1234
'

Dim oTimerEvents
Dim nTimerEventCount

Sub InitTriggerScript
	Set oTimerEvents = CreateObject("Scripting.Dictionary")
	nTimerEventCount = 0
End Sub

Sub pTriggerScript_Timer()
	Dim i, asKeys, avEvent, nTime, sStatement
	asKeys = oTimerEvents.keys
	For Each i in asKeys
 		avEvent = oTimerEvents.Item(i)
		If Not IsArray(avEvent) Then
			WriteToLog "TriggerScript", "Value for key " & i & " is not an array" &_
				"(type is " & TypeName(avEvent) & ")"
			oTimerEvents.Remove i
		Else
			nTime = avEvent(0)
			sStatement = avEvent(1)
			If nTime <= GameTime Then
				oTimerEvents.Remove i
				execute(sStatement)
			End If
		End If
	Next
	' Disable when we dont need it 
	If oTimerEvents.Count < 1 Then pTriggerScript.Enabled = False
End Sub

Function TriggerScript(pTimeMS, pScript) ' This is used to Trigger script after the pTriggerScript Timer
    nTimerEventCount = nTimerEventCount + 1
    ' Adds an item to the dictionary where the key is a counter (easiest way
    ' to have an unique key) and the value is an array, where the first index
    ' is the earliest GameTime when the script should be triggered, and the 
    ' second index is the script.
    oTimerEvents.Add nTimerEventCount, Array(GameTime + pTimeMS, pScript)
    if pTriggerScript.enabled=false Then pTriggerScript.enabled=true
	WriteToLog "TriggerScript", "pScript " & pScript & " , pTimeMS " & pTimeMS & " , Index " & nTimerEventCount
    TriggerScript = nTimerEventCount
end Function

Sub TriggersStopAll()
    oTimerEvents.RemoveAll
    pTriggerScript.Enabled = False
end Sub

Sub TriggerStopIndex(pTriggerIndex)
    If IsNumeric(pTriggerIndex) Then
        If oTimerEvents.Exists(pTriggerIndex) Then
			WriteToLog "TriggerScript", "Removed item with index " & pTriggerIndex
            oTimerEvents.Remove pTriggerIndex
		Else
			WriteToLog "TriggerScript", "Attempted to remove but index " & pTriggerIndex & " was not found"
        End If
	Else
		WriteToLog "TriggerScript", "Attempted to remove but index " & pTriggerIndex & " was not valid"
    End If
end Sub


