Sub swLeftOrb2_Hit
	If Not bGameInPlay Then Exit Sub
	OrbitSounds
	SkillshotOff
	lightCtrl.pulse f145,1 : DOF 145, DOFPulse
	If SwitchRecentlyHit("swLeftOrb1") Then

		If ModeRunning = "" Then
			lightCtrl.AddLightSeq "NAME", lSeqinsertleftlightblue
		End If


		If ModeRunning = "ambush" Then
			If Blink(eInsertBulletLoopLeft, 1) = 2 Then
				ChangeLampState eInsertBulletLoopLeft, 0
				ExtendAmbushMode
			End If
		End If

		If ModeRunning = "" Or ModeRunning = "ambush" Then
			If BulletsHit(1) = 0 And Player(CurrentPlayer).Collected_Bullets < 15 Then
				BulletsHit(1) = 1
				ChangeLamp 50,1,"red"	, 100,"110"	,12,3,3,0
				ChangeLamp 20,0,"red"	, 100,"110"	,5,2,2,0
				BulletCollector.enabled = False
				BulletCollector.enabled = True
				Blink_ComboBullets
			End If
		End If



		If ModeRunning = "ParkMB" Then
			checkParkMB eShotLoopLeft
		End If

		if ModeRunning = SimonGruberMode Then
			CheckSimonGruberShots eShotLoopLeft
		End If

		If ModeRunning = KatyaMode Then
			Check_Katya KatyaOrbitShot
		End If

		If ModeRunning = "TowerMB" Then
			NakatomiShotHit eShotLoopLeft
		End If

		If ModeRunning = "AirplaneMB" Then
			AirplaneShotHit eShotLoopLeft
		End If

		If ModeRunning = "VaultMB" Then
			VaultMultiballUpdate eShotLoopLeft
		End If

		If ModeRunning = WizardMode Then
			UpdateWizardMode
		End If

		If ModeRunning = ColStuartMode Then
			StuartShotHit eShotLoopLeft
		End If
	End If
	SwitchWasHit "swLeftOrb2"
End Sub 

