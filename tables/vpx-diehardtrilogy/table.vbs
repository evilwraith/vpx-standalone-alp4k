Dim FrameCounter
' The game timer interval is 10 ms
Sub GameTimer_Timer()
	Cor.Update 						'update ball tracking
	RollingUpdate					'update rolling sounds
	DoDTAnim						'update drop targets
	DoSTAnim
	If f140.getinplaystatebool <> 0 Then flasher001.visible = true : flasher002.visible = true Else flasher001.visible = False : flasher002.visible = False
	If f141.getinplaystatebool <> 0 Then flasher003.visible = true : flasher004.visible = true Else flasher003.visible = False : flasher004.visible = False

	UpdateStandupTargets
	If ModeRunning = KarlMode Then KarlTimer
	If ModeRunning = "" And Player(CurrentPlayer).ParkMBready Then ParKblink


	FrameCounter = FrameCounter + 1
	If (FrameCounter mod 222) = 1 And Blink(8,1)=1 Then lightCtrl.PulseWithColor l8,rgb(255,111,4),1


End Sub

