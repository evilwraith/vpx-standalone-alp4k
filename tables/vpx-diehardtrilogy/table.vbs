Dim anAirplaneShots
anAirplaneShots = Array(eShotLoopLeft, eShotRampLeft, eShotRampRight, eShotLoopRight)
Dim anAirplaneLights
anAirplaneLights = Array(eInsertBulletLoopLeft, eInsertBulletRampLeft, _
	eInsertBulletRampRight, eInsertBulletLoopRight)
Sub AirplaneShotHit (nShot)
	Dim i, j, nNewShot, nShotsUnlitCount, nShotsLit, bSuperHit, bSuperAdded
	WriteToLog "AirplaneShotHit", asShotNames(nShot) & " hit, " _
		& Player(CurrentPlayer).AirplaneJPsHit & " jackpots hit"

	If eShotCaptiveBall = nShot Then
		bSuperHit = False
		If (Not Player(CurrentPlayer).AirplaneMBstage2) _
		And 4 = Player(CurrentPlayer).AirplaneJPsHit Then
			AddScore score_AirplaneSuper
			bSuperHit = True
			Player(CurrentPlayer).AirplaneJPsHit = 5
			Player(CurrentPlayer).AirplaneMBstage2 = True
		Elseif Player(CurrentPlayer).AirplaneMBstage2 _
		And (((Player(CurrentPlayer).AirplaneJPsHit - 4) Mod 8) = 0) Then
			AddScore score_AirplaneSuper * 2
			bSuperHit = True
		End If
		If bSuperHit Then
			PupShowGameMessage "HIT CAPTIVE BALL TO LIGHT JACKPOTS!"
			
			PUP_SuperJackpot score_AirplaneSuper * 2
			ChangeLampState eInsertCaptiveLocks, 0
			ChangeLamp eInsertComboCaptive, 2 ,"yellow", 200,"10",1,0,0,0
		End If
		nNewShot = -1
		nShotsUnlitCount = 0
		' Standard technique for selecting a random element from a list of unknown length
		For i = 0 to 3
			If 0 = Blink(anAirplaneLights(i), 1) Then
				nShotsUnlitCount = nShotsUnlitCount + 1
				If Rnd < (1 / nShotsUnlitCount) Then
					nNewShot = i
				End If
			End If
		Next
		If nNewShot <> -1 Then
			nShotsUnlitCount = nShotsUnlitCount - 1
			AddScore score_AirplaneCaptive
			ChangeLamp anAirplaneLights(nNewShot),2,"whiteLED" ,200,"10" ,1,0,0,0
		End If
		If nShotsUnlitCount < 1 Then
			ChangeLampState eInsertComboCaptive, 0
		End If
	Else
		bSuperAdded = False
		' Check for jackpot lit at the shot
		For i = 0 to 3
			If nShot = anAirplaneShots(i) And 2 = Blink(anAirplaneLights(i), 1) Then
				' Award the jackpot
				if Player(CurrentPlayer).AirplaneMBstage2 Then
					AddScore score_AirplaneJackpot * 2
					PUP_Jackpot score_AirplaneJackpot * 2
				Else
					AddScore score_AirplaneJackpot
					PUP_Jackpot score_AirplaneJackpot
				End If
				
				Player(CurrentPlayer).AirplaneJPsHit = Player(CurrentPlayer).AirplaneJPsHit + 1
				' Check for super jackpot lit
				If (Not Player(CurrentPlayer).AirplaneMBstage2) _
				And 4 = Player(CurrentPlayer).AirplaneJPsHit Then
					PupShowGameMessage "SUPER JACKPOT IS LIT!"
					bSuperAdded = True
					For j = 0 to 3
						ChangeLampState anAirplaneLights(j), 0
					Next
					ChangeLamp eInsertCaptiveLocks, 2 ,"whiteLED", 100,"10",1,0,0,0
					ChangeLamp eInsertComboCaptive, 2 ,"whiteLED", 100,"10",1,0,0,0
				Elseif Player(CurrentPlayer).AirplaneMBstage2 _
				And (((Player(CurrentPlayer).AirplaneJPsHit - 4) Mod 8) = 0) Then
					PupShowGameMessage "SUPER JACKPOT IS LIT!"
					bSuperAdded = True
					ChangeLamp eInsertCaptiveLocks, 2 ,"whiteLED", 100,"10",1,0,0,0
					ChangeLamp eInsertComboCaptive, 2 ,"whiteLED", 100,"10",1,0,0,0
				Elseif Player(CurrentPlayer).AirplaneMBstage2 Then
					ChangeLamp eInsertComboCaptive, 2 ,"yellow", 200,"10",1,0,0,0
					ChangeLamp anAirplaneLights(i),0,"whiteLED" ,200,"10" ,1,0,0,0
				Else
					ChangeLamp anAirplaneLights(i),1,"whiteLED" ,200,"10" ,1,0,0,0
				End If

				' Show mode message depending on how many shots are lit
				If Not bSuperAdded Then
					nShotsLit = 0
					For j = 0 to 3
						If 2 = Blink(anAirplaneLights(j), 1) Then
							nShotsLit = nShotsLit + 1
						End If
					Next
					If nShotsLit < 1 Then
						PupShowGameMessage "HIT CAPTIVE BALL TO LIGHT JACKPOTS!"
					Elseif Player(CurrentPlayer).AirplaneMBstage2 Then
						j = 8 - ((Player(CurrentPlayer).AirplaneJPsHit - 4) Mod 8)
						If 1 = j Then
							PupShowGameMessage "1 MORE JACKPOT TO LIGHT SUPER"
						Else
							PupShowGameMessage j & " MORE JACKPOTS TO LIGHT SUPER"
						End If
					Else
						j = 4 - Player(CurrentPlayer).AirplaneJPsHit
						If 1 = j Then
							PupShowGameMessage "1 MORE JACKPOT TO LIGHT SUPER"
						Else
							PupShowGameMessage j & " MORE JACKPOTS TO LIGHT SUPER"
						End If				
					End If
				End If
			End If
		Next
	End If
End Sub

