Const bonus_ambush_collect = 200000
Const bonus_ambush_start = 50000
Const bonus_ambush_advance = 20000
Const bonus_ambush_no_advance = 5000

dim bonuses(6) ' array for bonus values

Sub InitBonus
	Dim i, nPoints, nVillainTotal
	ModeRunning = "bonus"

	nPoints = Player(CurrentPlayer).BonusBullets + Player(CurrentPlayer).BonusHolly + _
		Player(CurrentPlayer).BonusMultiballs + Player(CurrentPlayer).BonusAmbush
	nVillainTotal = 0
	for i = 0 to 4
		nVillainTotal = nVillainTotal + Player(CurrentPlayer).BonusVillains(i)
	next
	nVillainTotal = nVillainTotal * bonus_villain_factor
	nPoints = nPoints + nVillainTotal
	nPoints = nPoints * Player(CurrentPlayer).BonusMultiplier

	PointMultiplier = 1
	If Not bTilted Then addScore nPoints

	bonuses(0) = Player(CurrentPlayer).BonusBullets 'Bullets
	bonuses(1) = Player(CurrentPlayer).BonusMultiballs 'Multiball
	bonuses(2) = Player(CurrentPlayer).BonusAmbush 'Ambush
	bonuses(3) = Player(CurrentPlayer).BonusHolly 'Holly
	bonuses(4) = nVillainTotal 'Villain
	bonuses(5) = nPoints  'Bonus
	bonuses(6) = Player(CurrentPlayer).BonusMultiplier

	If bTilted Then
		StopMusic
		EndOfBallComplete
	Else
		lightCtrl.AddTableLightSeq "TEST", lSeqinsertrightlightblue
		lightCtrl.AddTableLightSeq "TEST", lSeqinsertleftlightblue
		lightCtrl.AddTableLightSeq "TEST", lSeqAllLightsTopGreen
		lightCtrl.AddTableLightSeq "TEST", lSeqinsertsuplightblue

		ShowBonus
	End If
End Sub



Sub ShowBonus ()
	WriteToLog "PUP", "ShowBonus"
	StopMusic

	if Player(CurrentPlayer).WizardStageReached = 4 Then 'If they reached the final wizard show the You Won video before doing the bonus sequence
		YouWon Player(CurrentPlayer).Score
		Exit Sub
	Else
		PlayBonus
	End If
End Sub

