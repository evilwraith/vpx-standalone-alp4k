dim gilvl:gilvl = 1
Sub SetGI(Enabled)
	dim xx
	If enabled Then
		for each xx in GI
			lightCtrl.LightOn xx
		Next
		if VRRoom <> 0 then VRLeftSpeakerFlasher.visible = true  'VR Callout
		if VRRoom <> 0 then VRRightSpeakerFlasher.visible = true  'VR Callout
		gilvl = 1
	Else
		for each xx in GI
			lightCtrl.LightOff xx
		Next
		if VRRoom <> 0 then VRLeftSpeakerFlasher.visible = false  'VR Callout
		if VRRoom <> 0 then VRRightSpeakerFlasher.visible = false  'VR Callout
		gilvl = 0
	End If
	Sound_GI_Relay enabled, bumper1
End Sub

Sub SetGILevel(level)
	dim xx
	for each xx in GI
		lightCtrl.LightLevel xx, level
	Next
	gilvl = level/100
	If level = 1 Then
		PuPEvent 17
	Else
		PuPEvent 18
	End If
End Sub


Sub SetGIColor(Col1,Col2,Col3)
	dim xx
	for each xx in GI
		lightCtrl.Lightcolor xx,RGB (col1,col2,col3)
	Next
	GiRGB(3)= col1
	GiRGB(4)= col2
	GiRGB(5)= col3
End Sub


