dim UCStrobeBlueNum: UCStrobeBlueNum = 1
dim UCStrobeBlueCount: UCStrobeBlueCount = 0
Dim AttractSeq:AttractSeq = 1
Dim Fade: Fade = 1


Sub UCAttractTimer_Timer()
	If Attractseq = 1 then UCPulseOn: UCShortStrobeBlue: Attractseq = 2: Exit Sub
	If Attractseq = 2 then UCPulseOff: Attractseq = 3: Exit Sub
	If Attractseq = 3 then UCFadeIn: UCShortStrobeBlue: Attractseq = 4: Exit Sub
	If Attractseq = 4 then UCFadeOut: Attractseq = 5: Exit Sub
	If Attractseq = 5 then UCStrobe: Attractseq = 1: Exit Sub
End Sub

' VR Undercab Callouts *********************************************************************
Sub UCFadeIn()  		UCDOF 2: If VRRoom=1 Then: UCFadeinTimer.enabled = true: End If: end Sub
Sub UCFadeout() 		UCDOF 3: If VRRoom=1 Then: UCFadeOutTimer.enabled = true: End If: end Sub
Sub UCShortStrobe() 	UCDOF 5: If VRRoom=1 Then: UCShortStrobeTimer.enabled = true: End If: end Sub
Sub UCStrobe() 			UCDOF 7: If VRRoom=1 Then: UCStrobeTimer.enabled = true: End If: end Sub
Sub UCPulseOn() 		UCDOF 1: If VRRoom=1 Then: UndercabTimer.enabled = true: End If: end Sub
Sub UCPulseOff() 				 If VRRoom=1 Then: UndercabTimer.enabled = false: UCFadeout: End If: end sub
Sub UCFlash() 			UCDOF 3: If VRRoom=1 Then: UCFadeOutTimer.enabled = false: UndercabTest1.opacity = 35: UCFadeOutTimer.enabled = true: End If: End sub
Sub UCFlashBlue()  		UCDOF 4: If VRRoom=1 Then: UCFadeOutBlueTimer.enabled = false: UndercabTestBlue.opacity = 35: UCFadeOutBlueTimer.enabled = true: End If: End sub
Sub UCShortStrobeBlue() UCDOF 6: If VRRoom=1 Then: UCShortStrobeBlueTimer.enabled = true: End If: end Sub
'*******************************************************************************************

Sub UnderCabTimer_Timer()
	UndercabTest1.opacity = UndercabTest1.opacity  + UnderSpeed
	If UndercabTest1.opacity => 35 then UnderSpeed = -1: End If
	If UndercabTest1.opacity =< 0 then UnderSpeed = 1: End If
End Sub

Sub UCFadeInTimer_Timer()
	if UndercabTest1.opacity =< 35 then UndercabTest1.opacity = UndercabTest1.opacity  + 1
	if UndercabTest1.opacity => 35 then UCFadeInTimer.enabled = false
end Sub

Sub UCFadeOutTimer_Timer()
	if UndercabTest1.opacity => 0 then UndercabTest1.opacity = UndercabTest1.opacity  - 1
	if UndercabTest1.opacity =< 0 then UCFadeOutTimer.enabled = false
end Sub

Sub UCFadeOutBlueTimer_Timer()
	if UndercabTestBlue.opacity => 0 then UndercabTestBlue.opacity = UndercabTestBlue.opacity  - 1
	if UndercabTestBlue.opacity =< 0 then UCFadeOutBlueTimer.enabled = false
end Sub

Sub UCShortStrobeTimer_Timer()
	if UCStrobeCount => 10 then UCStrobeCount = 0: UndercabTest1.opacity = 0: UCShortStrobeTimer.enabled = false: Exit sub
	If UCStrobeNum = 1 then UndercabTest1.opacity = 35 : UCStrobeNum = 2: UCStrobeCount = UCStrobeCount + 1: Exit Sub
	If UCStrobeNum = 2 then UndercabTest1.opacity = 0 : UCStrobeNum = 1: Exit Sub
end Sub

Sub UCShortStrobeBlueTimer_Timer()
	if UCStrobeBlueCount => 10 then UCStrobeBlueCount = 0: UndercabTestBlue.opacity = 0: UCShortStrobeBlueTimer.enabled = false: Exit sub
	If UCStrobeBlueNum = 1 then UndercabTestBlue.opacity = 35 : UCStrobeBlueNum = 2: UCStrobeBlueCount = UCStrobeBlueCount + 1: Exit Sub
	If UCStrobeBlueNum = 2 then UndercabTestBlue.opacity = 0 : UCStrobeBlueNum = 1: Exit Sub
end Sub

Sub UCStrobeTimer_Timer()
	if UCStrobeCount => 27 then UCStrobeCount = 0: UndercabTest1.opacity = 0: UCStrobeTimer.enabled = false: Exit sub
	If UCStrobeNum = 1 then UndercabTest1.opacity = 35 : UCStrobeNum = 2: UCStrobeCount = UCStrobeCount + 1: Exit Sub
	If UCStrobeNum = 2 then UndercabTest1.opacity = 0 : UCStrobeNum = 1: Exit Sub
end Sub

Sub UCDOF(state)
	Select Case state
		Case 0: 				'Off
			DOF 150,DOFOff
			DOF 151,DOFOff
		Case 1: 				'UnderCabTimer:  red fades in and out slowly
			DOF 150,DOFOn
			DOF 151,DOFOff
		Case 2: 				'UCFadeInTimer:  red fades in and holds
			DOF 151,DOFOn
			DOF 150,DOFOff
		Case 3: 				'UCFadeOutTimer:  red on then fades out
			DOF 152,DOFPulse
			DOF 150,DOFOff
			DOF 151,DOFOff
		Case 4: 				'UCFadeOutBlueTimer:  blue on then fades out
			DOF 153,DOFPulse
		Case 5: 				'UCShortStrobeTimer:  red quick strobe, 10 flashes
			DOF 154,DOFPulse
			DOF 150,DOFOff
			DOF 151,DOFOff
		Case 6: 				'UCShortStrobeBlueTimer:  blue quick strobe, 10 flashes
			DOF 155,DOFPulse
		Case 7: 				'UCStrobeTimer:  red strobe, 27 flashes
			DOF 156,DOFPulse
			DOF 150,DOFOff
			DOF 151,DOFOff
	End Select
End Sub

