Sub VaultMultiballStart
	Dim i

	DOF 131,DOFOn
	ShowVaultOpensVideo
	KickerVault1.timerinterval=18000
	KickerVault1.timerenabled=True
	vVaultShotsLit.Clear
	Player(CurrentPlayer).VaultMultiballReady = False
	ModeRunning = "VaultMB"

	' Since this is a 5 ball multiball, empty the physical lock
	' Adjust delay to video length, add 100 ms to make sure that the
	' vault kicker ejects before changing its timer interval
	TriggerScript 1100, "VaultMultiballRelease"

	UpdateLightsAll
	For Each i in Array(eShotLoopLeft, eShotRampLeft, eShotLoopUpper, _
	eShotRampRight, eShotCaptiveBall, eShotLoopRight)
		vVaultShotsLit.add i
		ChangeLamp anInsertsForShot(i) , 2 ,"yellow", 200, "10",1,0,0,0
	Next
	ChangeLampState eInsertVault, 0
	PupShowGameMessage "YELLOW SHOTS LIGHT VAULT JACKPOT"
	HideBullets
End Sub

Sub VaultMultiballRelease
	Dim ballsToPlunge

	BallsOnPlayfield = BallsOnPlayfield + NakatomiPhysicalLocks
	ballsToPlunge = 4 - NakatomiPhysicalLocks
	AddMultiball ballsToPlunge
	NakatomiPhysicalLocks = 0
	lockkicker1.kick 0,0
	lockkicker2.kick 0,0
	lockkicker3.kick 0,0
	LockKicker1.enabled=False
	LockKicker2.enabled=False
	LockKicker3.enabled=False
	Start_Ballsave Vault_BallSaverTime
	KickerVault1.timerinterval = 250
End Sub

Sub VaultMultiballUpdate (nShot)
	Dim i, nValue, nShotsHit
	
	nShotsHit = 6 - vVaultShotsLit.Count
	nValue = 0
	For i = 0 to nShotsHit - 1
		nValue = nValue + score_vaultmb_baseJP + (score_vaultmb_buildJP * i)
	Next

	If vVaultShotsLit.Contains(nShot) Then
		vVaultShotsLit.remove nShot
		ChangeLampState anInsertsForShot(nShot), 0
		nValue = nValue + score_vaultmb_baseJP + (score_vaultmb_buildJP * nShotsHit)
		
		AddScore score_vaultmb_lightJP
		PUP_IncreaseJackPot(nValue)
		PupShowGameMessage "VAULT JACKPOT = " & formatScore(nValue)
		If 0 = nShotsHit Then
			OpenVaultDoor
			ChangeLamp eInsertVault, 2 ,"orange", 120, "10",1,0,0,0
		End If
	Elseif eShotVault = nShot and nValue > 0 Then
		For Each i in Array(eShotLoopLeft, eShotRampLeft, eShotLoopUpper, _
		eShotRampRight, eShotCaptiveBall, eShotLoopRight)
			vVaultShotsLit.add i
			ChangeLampState anInsertsForShot(i), 0
			ChangeLamp anInsertsForShot(i) , 2 ,"yellow", 200, "10",1,0,0,0
		Next
		PupShowGameMessage "YELLOW SHOTS LIGHT VAULT JACKPOT"
		CloseVaultDoor
		ChangeLampState eInsertVault, 0
		AddScore nValue
		PUP_Jackpot nValue
	End If
End Sub

Sub VaultMultiballEnd
	Dim i

	DOF 131,DOFOff
	pupClearGameMessage
	ModeRunning = ""
	ShowBullets Player(CurrentPlayer).Collected_Bullets
	EndVaultMBVideo
	If KickerVault1.timerenabled Then
		KickerVault1.kick 0,60
		KickerVault1.timerenabled=false
		DOF 113,DOFPulse
	End If
	KickerVault1.timerinterval = 250
	' Reset Nakatomi lock state
	LockKicker1.enabled=True
	LockKicker2.enabled=False
	LockKicker3.enabled=False

	If (Player(CurrentPlayer).vaultTargetCount >= 2) _
	And (not bVaultDoorOpen) Then
		OpenVaultDoor
	Elseif (Player(CurrentPlayer).vaultTargetCount < 2) _
	And bVaultDoorOpen Then
		CloseVaultDoor
	End If
	For Each i in Array(eShotLoopLeft, eShotRampLeft, eShotLoopUpper, _
	eShotRampRight, eShotCaptiveBall, eShotLoopRight)
		ChangeLampState anInsertsForShot(i) , 0
	Next
	ChangeLampState eInsertVault, 0
	UpdateLightsAll

End Sub

