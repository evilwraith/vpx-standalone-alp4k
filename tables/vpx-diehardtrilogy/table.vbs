Sub CheckParkJackpot(bAwarded)
	Dim i, nLanesHit

	nLanesHit = 0
	If Player(CurrentPlayer).rollover1 Then nLanesHit = nLanesHit + 1
	If Player(CurrentPlayer).rollover2 Then nLanesHit = nLanesHit + 1
	If Player(CurrentPlayer).rollover3 Then nLanesHit = nLanesHit + 1

	If bAwarded Then
		If Player(CurrentPlayer).ParkSuperCollected Then
			Player(CurrentPlayer).ParkShotsHit.Add Player(CurrentPlayer).ParkPreviousShot
		End If
		Select Case nLanesHit
			Case 0, 1
				If Player(CurrentPlayer).ParkSuperCollected Then
					AddScore score_ParkMB_JP * 2
					PUP_Jackpot score_ParkMB_JP * 2
				Else
					AddScore score_ParkMB_JP
					PUP_Jackpot score_ParkMB_JP
				End If
				
			Case 2
				If Player(CurrentPlayer).ParkSuperCollected Then
					AddScore score_ParkMB_JP * 4
					PUP_Jackpot score_ParkMB_JP * 4
				Else
					AddScore score_ParkMB_JP * 2
					PUP_Jackpot score_ParkMB_JP * 2
				End If
			
			Case Else
				If Player(CurrentPlayer).ParkSuperCollected Then
					AddScore score_ParkMB_SuperJP * 2
					PuP_SuperJackpot score_ParkMB_SuperJP * 2
					Player(CurrentPlayer).ParkShotsHit.Clear
				Else
					AddScore score_ParkMB_SuperJP
					PuP_SuperJackpot score_ParkMB_SuperJP
				End If
				
				Player(CurrentPlayer).rollover1 = False
				Player(CurrentPlayer).rollover2 = False
				Player(CurrentPlayer).rollover3 = False
				Player(CurrentPlayer).ParkSuperCollected = True
		End Select
		PupShowGameMessage "HIT A GREEN SHOT TO LIGHT PARK JACKPOT!"
	end if

	Player(CurrentPlayer).ParkJPLit = False
	For Each i in Array(eShotLoopLeft, eShotRampRight, _
	eShotLoopUpper, eShotLoopRight)
		If Player(CurrentPlayer).ParkShotsHit.Contains(i) Then
			ChangeLampState anInsertsForShot(i), 0
		Else
			ChangeLamp anInsertsForShot(i), 2, "green", 200, "10", 1, 0, 0, 0
		End If
	Next
	ChangeLampState eInsertBulletRampLeft, 0

	For each i in Array(eInsertParkLeft, eInsertParkCenter, eInsertParkRight)
		ChangeLampState i, 0
	Next

	If Player(CurrentPlayer).rollover1 Then ChangeLampState eInsertParkLeft, 1
	If Player(CurrentPlayer).rollover2 Then ChangeLampState eInsertParkCenter, 1
	If Player(CurrentPlayer).rollover3 Then ChangeLampState eInsertParkRight, 1
End Sub


