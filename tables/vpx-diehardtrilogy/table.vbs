'red to green with two stops: yellow at 50% progress and orange at 75% 
Function MakeGradident()
    ' Define the start and end colors
    Dim startColor
    Dim endColor
    startColor = "993400"  ' Red
    endColor = "FF0000"    ' Green

    ' Define the stop positions and colors
    Dim stopPositions(2)
    Dim stopColors(2)
    stopPositions(0) = 0    ' Start at 0%
    stopColors(0) = "993400" ' Red
    stopPositions(1) = 50   ' Yellow at 50%
    stopColors(1) = "FFA500" ' Yellow
    stopPositions(2) = 75   ' Orange at 75%
    stopColors(2) = "FF0000" ' Orange

    ' Call the GetGradientColorsWithStops function to generate the gradient colors
    MakeGradident = lightCtrl.GetGradientColorsWithStops(startColor, endColor, stopPositions, stopColors)

End Function

'red to green with two stops: yellow at 50% progress and orange at 75% 
Function MakeRainbowGradident()
    ' Define the start and end colors
    Dim startColor
    Dim endColor
	startColor = "FF0000"  ' Red
    endColor = "4B0082"    ' Indigo (a shade of blueish-purple)

    ' Define the stop positions and colors for a rainbow gradient
    Dim stopPositions(6)
    Dim stopColors(6)
    stopPositions(0) = 0    ' Red at the beginning
    stopColors(0) = "F0000"
    stopPositions(1) = 14   ' Orange
    stopColors(1) = "FFA500"
    stopPositions(2) = 28   ' Yellow
    stopColors(2) = "FFFF00"
    stopPositions(3) = 42   ' Green
    stopColors(3) = "008000"
    stopPositions(4) = 56   ' Blue
    stopColors(4) = "0000FF"
    stopPositions(5) = 70   ' Indigo
    stopColors(5) = "4B0082"
    stopPositions(6) = 100  ' Violet at the end
    stopColors(6) = "9400D3"

    ' Call the GetGradientColorsWithStops function to generate the gradient colors
    MakeRainbowGradident = lightCtrl.GetGradientColorsWithStops(startColor, endColor, stopPositions, stopColors)

    ' Now, gradientColors array contains the gradient colors
    ' You can use these colors to draw the progress bar or apply them to UI elements
End Function

Function MakeChristmasGradident()
    ' Define the start and end colors
    Dim startColor
    Dim endColor
	startColor = "FF0000"  ' Red
    endColor = "00FF00"    ' Green

    ' Define the stop positions and colors for a Christmas lights gradient
    Dim stopPositions(3)
    Dim stopColors(3)
    stopPositions(0) = 0     ' Red at the beginning
    stopColors(0) = "FF0000"
    stopPositions(1) = 50    ' White in the middle
    stopColors(1) = "FFFFFF"
    stopPositions(2) = 100   ' Green at the end
    stopColors(2) = "00FF00"
    stopPositions(3) = 100   ' Green at the end
    stopColors(3) = "00FF00"

    ' Call the GetGradientColorsWithStops function to generate the gradient colors
    MakeChristmasGradident = lightCtrl.GetGradientColorsWithStops(startColor, endColor, stopPositions, stopColors)

    ' Now, gradientColors array contains the gradient colors
    ' You can use these colors to draw the progress bar or apply them to UI elements
End Function




