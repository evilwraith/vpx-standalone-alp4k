			If bulletcolor1 > 222 then bulletcolor1 = bulletcolor1 - 1
			If bulletcolor2 < 12 then bulletcolor2 = bulletcolor2 + 1
			If bulletcolor2 > 12 then bulletcolor2 = bulletcolor2 - 1
			If bulletcolor3 < 12 then bulletcolor3 = bulletcolor3 + 1
			If bulletcolor3 > 12 then bulletcolor3 = bulletcolor3 - 1
		case 3 :
			If bulletcolor1 < 6 then bulletcolor1 = bulletcolor1 + 1
			If bulletcolor1 > 6 then bulletcolor1 = bulletcolor1 - 1
			If bulletcolor2 < 12 then bulletcolor2 = bulletcolor2 + 1
			If bulletcolor2 > 12 then bulletcolor2 = bulletcolor2 - 1
			If bulletcolor3 < 256 then bulletcolor3 = bulletcolor3 + 1
