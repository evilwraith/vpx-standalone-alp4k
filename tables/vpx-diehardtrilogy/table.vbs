'****  Airplane moving - oqqsan    added the goblin shaker from SpiderMan
'******************************************************

'command to go up / down =      AirplanePos= % of max movement  0-100   ( under 10 is too low )

Dim AirplaneShake
Dim AirplaneCounter


Sub DoThePlaneShake
	AirplaneShake = 8
End	Sub


Sub AirplaneControl
	If AirplaneShake <> 0 Then AirplaneShakeSome
	If AirplaneCounter < AirplanePos Then 'Up
		AirplaneCounter=AirplaneCounter+2
	ElseIf AirplaneCounter > AirplanePos Then
		AirplaneCounter=AirplaneCounter-1
	End If

	Dim el
	For Each el in BP_PlanePrim
		el.RotX = -3 + 0.25 * ( AirplaneCounter + AirplaneShake )
		el.Roty = -3 + 0.25 * ( AirplaneCounter + AirplaneShake )
	Next
	For Each el in BP_PlanePrimPost
		el.z = 29 + AirplaneCounter + AirplaneShake
	Next

End Sub



Dim doubletimeshaker
Sub AirplaneShakeSome
	If doubletimeshaker > 1 Then
		doubletimeshaker = 0
		If AirplaneShake < 0 Then
			AirplaneShake = ABS(AirplaneShake) - 1
			Playsound "shake",1,0.1*VolumeDial
		Else
			AirplaneShake = - AirplaneShake + 1
		End If
	Else
		doubletimeshaker = doubletimeshaker + 1
	End If
End Sub



