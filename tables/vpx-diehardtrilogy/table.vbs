			If bulletcolor1 > 12 then bulletcolor1 = bulletcolor1 - 1
			If bulletcolor2 < 200 then bulletcolor2 = bulletcolor2 + 1
			If bulletcolor2 > 200 then bulletcolor2 = bulletcolor2 - 1
			If bulletcolor3 < 12 then bulletcolor3 = bulletcolor3 + 1
			If bulletcolor3 > 12 then bulletcolor3 = bulletcolor3 - 1
		case 2 :
