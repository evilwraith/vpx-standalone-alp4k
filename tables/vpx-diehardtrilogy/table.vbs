'This sorts the high score names / scores
Sub SortHighscore
	WriteToLog "PUP", "SortHighscore"
    Dim tmp, tmp2, i, j
    For i = 0 to 3
        For j = 0 to 2
            If HighScore(j) <HighScore(j + 1) Then
                tmp = HighScore(j + 1)
                tmp2 = HighScoreName(j + 1)
                HighScore(j + 1) = HighScore(j)
                HighScoreName(j + 1) = HighScoreName(j)
                HighScore(j) = tmp
                HighScoreName(j) = tmp2
            End If
        Next
    Next

	WriteToLog "PUP", "SortHighscore 0 Name and Score: " & HighScoreName(0) & " " & HighScore(1)
	WriteToLog "PUP", "SortHighscore 0 Name and Score: " & HighScoreName(1) & " " & HighScore(1)
	WriteToLog "PUP", "SortHighscore 0 Name and Score: " & HighScoreName(1) & " " & HighScore(1)

End Sub



