Sub ShowHealthBars
	WriteToLog "PUP", "ShowHealthBars"
	PuPlayer.LabelSet pDMD,"KarlHealthLabel", "Karl\\karl12.png" ,1,""
	PuPlayer.LabelSet pDMD,"JohnHealthLabel", "Karl\\john12.png" ,1,""	
