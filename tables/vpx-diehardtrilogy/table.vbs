Dim bBackglassOff: bBackglassOff = False
Sub L109_animate
	If bAttractMode=False Then
		Dim f: f = L109.GetInPlayIntensity / L109.Intensity
		If f < 0.5 and bBackglassOff = False Then 
			bBackglassOff = True
			pupTurnBackglassOff
			BGFlickerTimer.Enabled = True
		End If
	End If
End Sub

BGFlickerTimer.interval = 1000
Sub BGFlickerTimer_Timer
	Dim f: f = L109.GetInPlayIntensity / L109.Intensity
	If f > 0.5 Then
		bBackglassOff = False
		BGFlickerTimer.Enabled = False
		pupTurnBackglassOn
	End If
End Sub



