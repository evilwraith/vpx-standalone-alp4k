'***********************************************************************************
' Function to determine if the player is tryng to select a previously defeated mode.
' returns true (has been defeated) or false
'***********************************************************************************
Function isDefeated(villain)
	WriteToLog "PUP","In isDefeated with villain: " & villain

	dim villainDefeated:villainDefeated = False

		Select Case villain
		Case HansGruberMode
			if Player(CurrentPlayer).HansGruberModeComplete = True Then
				villainDefeated = true
			End If
		Case KatyaMode
			if Player(CurrentPlayer).KatyaModeComplete = True Then
				villainDefeated = true
			End If
		Case KarlMode
			if Player(CurrentPlayer).KarlModeComplete = True Then
				villainDefeated = true
			End If
		Case ColStuartMode
			if Player(CurrentPlayer).ColStuartModeComplete = True Then
				villainDefeated = true
			End If
		Case SimonGruberMode
			if Player(CurrentPlayer).SimonGruberModeComplete = True Then
				villainDefeated = true
			End If
	End Select

	isDefeated = villainDefeated
End Function

'deifnes the mode (DIEHARD, DIEHARDER), sets default to DieHard
Dim diehardMode:diehardMode = DIEHARD

Dim diehardModeArray:diehardModeArray = Array(DIEHARD,DIEHARDER)
Dim diehardArrayIndex:diehardArrayIndex = 0

'handles the keystrokes for the Die Hard / Die Harder Selections
Sub DieHardSelect (keycode)
	If keycode = PlungerKey Then
'		Plunger.PullBack
		diehardMode = diehardModeArray(diehardArrayIndex)
		ExitDieHardSelect

		lightCtrl.AddTableLightSeq "TEST", lSeqalllights3

		WriteToLog "DieHardSelect", "Selected Mode is " & diehardModeArray(diehardArrayIndex) & " and Villain is " &villainArray(villainArrayIndex)
	End If

	If keycode = LeftFlipperKey Then
		LeftFlipper.RotateToEnd

		if diehardArrayIndex = 0 Then 
			diehardArrayIndex = 1
		else diehardArrayIndex = diehardArrayIndex - 1
		end if 
		FireDieHardModePupEvent villainArray(villainArrayIndex),diehardModeArray(diehardArrayIndex)
		
	End If

	If keycode = RightFlipperKey Then
		RightFlipper.RotateToEnd

		if diehardArrayIndex = 1 Then 
			diehardArrayIndex = 0
		else diehardArrayIndex = diehardArrayIndex + 1
		end if 
		FireDieHardModePupEvent villainArray(villainArrayIndex), diehardModeArray(diehardArrayIndex)
	End If
	


End Sub

'Exits the Die Hard Select mode and resets the pupdmd labels page back to the scores
Sub ExitDieHardSelect
	PuPEvent 55 ' Stop Player
	PuPEvent(9) ' start background video
	pDMDSetPage(pScores)
	PuPEvent(CurrentPlayer) ' start current player frame

	StartMode villainArray(villainArrayIndex)

	TriggerScript 3600, "SolRightVUK True"
	inDieHardSelect = False

End Sub


'Fires the pup event for the correct villain select video
Sub FireVillainPupEvent (villain)
	Select Case villain
		Case HansGruberMode
			if Player(CurrentPlayer).HansGruberModeComplete = True Then
				PupEvent 71
			else 
				PupEvent 50
			End If
		Case KatyaMode
			if Player(CurrentPlayer).KatyaModeComplete = True Then
				PupEvent 73
			else
				PupEvent 51
			End If
		Case KarlMode
			if Player(CurrentPlayer).KarlModeComplete = True Then
				PupEvent 72
			else
				PupEvent 52
			End If
		Case ColStuartMode
			if Player(CurrentPlayer).ColStuartModeComplete = True Then
				PupEvent 70
			else
				PupEvent 53
			End If
		Case SimonGruberMode
			if Player(CurrentPlayer).SimonGruberModeComplete = True Then
				PupEvent 74
			else
				PupEvent 54
			End If
	End Select
End Sub

'Fires the pup event for the correct Die Hard/Die Harder Villain video
Sub FireDieHardModePupEvent (villain, mode)
	if mode = DIEHARD Then
		Select Case villain
			Case HansGruberMode
				PupEvent 40
			Case KatyaMode
				PupEvent 46
			Case KarlMode
				PupEvent 44
			Case ColStuartMode
				PupEvent 42
			Case SimonGruberMode
				PupEvent 48
		End Select
	elseif mode = DIEHARDER Then
		Select Case villain
			Case HansGruberMode
				PupEvent 41
			Case KatyaMode
				PupEvent 47
			Case KarlMode
				PupEvent 45
			Case ColStuartMode
				PupEvent 43
			Case SimonGruberMode
				PupEvent 49
		End Select
	end if
End Sub

