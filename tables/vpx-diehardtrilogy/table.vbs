	For Each t in BP_TargetY : t.transy = BM_TargetY.transy : Next
	For Each t in BP_Target002 : t.transy = BM_Target002.transy : Next
	For Each t in BP_Target003 : t.transy = BM_Target003.transy : Next
	For Each t in BP_Target004 : t.transy = BM_Target004.transy : Next

End Sub


