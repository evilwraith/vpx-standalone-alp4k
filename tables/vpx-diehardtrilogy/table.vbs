		If DIEHARDER = diehardMode Then
			Player(CurrentPlayer).StuartBonus = True
		End If
		CheckModeExtraBall 5800
		CheckWizardMode
	Elseif BallsOnPlayfield > 0 Then
		If DIEHARDER = diehardMode Then
