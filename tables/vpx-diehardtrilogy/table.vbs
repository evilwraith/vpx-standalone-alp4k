Sub EndOfBallComplete
	WriteToLog "EndOfBallComplete", ""
	
	' Disable Tilt
	bTilted = False
	Tilt = 0
	MechTilt = 0
	If "bonus" = ModeRunning Then
		ModeRunning = ""
		if Player(CurrentPlayer).ExtraBalls > 0 Then
			Player(CurrentPlayer).ExtraBalls = Player(CurrentPlayer).ExtraBalls - 1
			GameplayRandomMusic
			pDMDSetPage(pScores) 
			pDMDSetHUD 1
			pupChangeDMDBackground 0 ' Do we need to track each player's current background screen?
			ResetForNewBall
			ShootAgain
			ReleaseNewBall
		Else
			NextPlayer
		End If
	End If
	BonusEnded = false
End Sub








