' This is to store the previously selected key, used for determineing what key to deselct
' This should be reset for each player's input
Dim PrevSelectedKey:PrevSelectedKey=""

' Sub used for "selecting" or highlighting the selected key on the HS on-screen keypad
Sub SelectKey (keypadLetter)
	WriteToLog "PUP", "SelectKey" & " keypad letter is " & keypadLetter
	'check if a previous letter was selected and if the current letter is END or DEL
	if NOT PrevSelectedKey = "" Then
		WriteToLog "PUP" , "SelectKey" & " The prevselected key was " & PrevSelectedKey
		if keypadLetter = "_" Then 
			WriteToLog "PUP", "SelectKey" & " Commit Name End and exit sub "
		ElseIf keypadLetter = "<" Then 
			WriteToLog "PUP", "SelectKey" & " Delete Intial"'Del and exit sub
		Else 
			DeselectKey(PrevSelectedKey)
		End If
	End if

	'End Key highlight
	if keypadLetter = "_" Then
		PuPlayer.LabelSet pDMD,"END", "" ,1,""
		DeselectKey(PrevSelectedKey)
		PrevSelectedKey = "_"
	'Delete Key highlight
	Elseif	keypadLetter = "<" Then
		PuPlayer.LabelSet pDMD,"DEL", "" ,1,""
		DeselectKey(PrevSelectedKey)
		PrevSelectedKey = "<"
	Else
		WriteToLog "PUP", "SelectKey" & " setting label for key " & keypadLetter
		PuPlayer.LabelSet pDMD,keypadLetter, "" ,1,""
		DeselectKey(PrevSelectedKey)
		PrevSelectedKey = keypadLetter
	End If
	
End Sub

'Sub to deselct the keyboard key image
Sub DeselectKey (keypadLetter)
	if keypadLetter = "_" Then
		PuPlayer.LabelSet pDMD,"END", "" ,0,""
	Elseif	keypadLetter = "<" Then
		PuPlayer.LabelSet pDMD,"DEL", "" ,0,""
	Else
	PuPlayer.LabelSet pDMD,keypadLetter, "" ,0,""
	End If
End Sub

