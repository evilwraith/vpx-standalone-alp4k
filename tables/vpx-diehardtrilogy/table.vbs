dim EOBCurIndex

'use this to adjust the speed of the bonus display
dim BonusSpeed:BonusSpeed = 1000

sub EndOfBallNext
	Dim i
	WriteToLog "PUP", "EndOfBallNext" & EOBCurIndex

	
	' Check the bonus is not already skipped
	If ModeRunning <> "bonus" or EOBCurIndex > 6 then exit sub

	For i = EOBCurIndex to 6
		if bonuses(i) <> 0 or 6 = i Then
			EOBCurIndex = i
			Exit For
		Else
			WriteToLog "PUP", "EndOfBallNext; Skipping zero bonus " & i
		end if
	Next

	If EOBCurIndex = 6 Then 
		EndBonus
		Exit Sub
