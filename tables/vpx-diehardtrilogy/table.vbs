dim KeyboardMode:KeyboardMode=false
' Sub to initialize the HighScore Entry dims
' This sub sets us into the HS Mode
Sub HighScoreEntryInit()
	WriteToLog "PUP", "HighScoreEntryInit "
	hsbModeActive = True
	KeyboardMode = true
	
	WriteToLog "PUP", "HighScoreEntryInit " & " showing keyboard"
	pDMDStopBackLoop ' stop the looping background
	PupEvent 103 ' turn on keyboard
	pDMDSetPage(pKeyboard) 'set this for the keyboard labels
    
	'Set the labels on the kepboard image to show the player number and their score
	PuPlayer.LabelSet pDMD,"HSScore",FormatNumber(Player(CurrentPlayer).Score,0),1,""
	PuPlayer.LabelSet pDMD,"HSPlayer",FormatNumber(CurrentPlayer,0),1,""

	'This array holds the 3 Initial digits.  Setting to blank for initial state
    hsEnteredDigits(0) = " "
    hsEnteredDigits(1) = " "
    hsEnteredDigits(2) = " "
    hsCurrentDigit = 0

	'Index of the current letter the player is on in the HS keyboard
	' ***Always reset to 1 (A) after comitting the HS name to be ready for next player
	hsCurrentLetter = 1 'set index of letter to 1 to start string

    HighScoreDisplayName()
End Sub

' This sub handles the keystrokes for entering a HighScore
' it should be called at the beginng of keydown section to intercept the keystokes when hsbModeActive=true
Sub EnterHighScoreKey(keycode)
	WriteToLog "PUP", "EnterHighScoreKey " & hsCurrentLetter

    If keycode = LeftFlipperKey Then
		' decrease the hsCurrentLetter on left flipper
        hsCurrentLetter = hsCurrentLetter - 1
		
		'index cannot be 0, must be 1-length of hsValidLetters
        if(hsCurrentLetter <= 0) then
            hsCurrentLetter = len(hsValidLetters) ' this pulls the current letter from the list of letters
			WriteToLog "PUP", "hsCurrentLetter is " & hsCurrentLetter
        end if
		WriteToLog "PUP", " LeftFlip Current letter is " & hsCurrentLetter
        HighScoreDisplayName()
    End If

    If keycode = RightFlipperKey Then
		' increase the hsCurrentLetter for right flipper
        hsCurrentLetter = hsCurrentLetter + 1
		' index cannot be greater than the length of the hsValidLetters
        if(hsCurrentLetter > len(hsValidLetters) ) then
            hsCurrentLetter = 1 ' maintain the index of valid letters when scrollign through
        end if

		WriteToLog "PUP", "EnterHighScoreKey " &  " RightFlip Current letter is " & hsCurrentLetter

        HighScoreDisplayName()
    End If

    If keycode = PlungerKey Or keycode = StartGameKey Or keycode = LockBarKey Then

		' capture a local dim of the currently selected character
		dim localCurrentLetter: localCurrentLetter = mid(hsValidLetters, hsCurrentLetter, 1)

		WriteToLog "PUP", "EnterHighScoreKey " &  " in PlungerKey localCurrentLetter is " & localCurrentLetter

		'if preselected key is not "" AND current selection is NOT END then set the key to the current index of the intials
		' if the current key is END AND there is a value in the Initials then commit name
		if(NOT localCurrentLetter="<" AND NOT localCurrentLetter="_") then 'if any letter other than back or end, add intiial
            
			hsEnteredDigits(hsCurrentDigit) = mid(hsValidLetters, hsCurrentLetter, 1) ' set the current digit in array
			 
			DisplayHSInitial localCurrentLetter, hsCurrentDigit
            hsCurrentDigit = hsCurrentDigit + 1 ' increase the index of the initials
            if(hsCurrentDigit = 3) then ' if current index is 3 then set to 2
                hsCurrentDigit = 2
				hsCurrentLetter = 27 ' Move to END after entering third letter
				HighScoreDisplayName() 'else display the name
            end if
        
		elseif localCurrentLetter="<" Then ' this is the back arrow, delete initial..

			WriteToLog "PUP", "EnterHighScoreKey " &  " in PlungerKey Deleting Character is hsCurrentDigit " & hsCurrentDigit

            hsEnteredDigits(hsCurrentDigit) = "" 'clear the current digit
			DeleteHSInitial hsCurrentDigit ' clear the top initial label

            if(Not hsCurrentDigit = 0) then ' if the current index is greater than 0 then decrement the current index
                hsCurrentDigit = hsCurrentDigit - 1
            end if 

            HighScoreDisplayName()

		ElseIf localCurrentLetter="_" Then ' this is the end button
			HighScoreCommitName()
        End if

    End if
End Sub

' Sub that sets the label for the initials as the player selects them
Sub DisplayHSInitial(localCurrentLetter, hsCurrentDigit)
	WriteToLog "PUP", "DisplayHSInitial: " &  " hsCurrentDigit " & hsCurrentDigit & " localCurrentLetter: " & localCurrentLetter
