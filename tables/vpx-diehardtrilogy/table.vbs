' Return the shot that is currently lit in Simon mode
Function getSimonLitShot()
	Dim nSimonIndex
	If isArray(SimonGruberModeShots) Then
		nSimonIndex = Player(CurrentPlayer).SimonGruberModeProgress
		getSimonLitShot = SimonGruberModeShots(nSimonIndex)
	Else
		getSimonLitShot = eShotNone
	End If
End Function

' *********************************************
' *      This will configure the shot callout for each level of simon says
' *********************************************

Sub NewSimonShot()
	Dim i, nShot, nProgress, nDisplayTime
	WriteToLog "=================", "NewSimonShot "

	' Turn off lights for unlit shots
	For Each i in Array(eInsertBulletLoopLeft, eInsertBulletLoopRight, eInsertComboCaptive, _
		eInsertBulletRampRight, eInsertBulletRampLeft)
		ChangeLampState i, 0
	Next

	Player(CurrentPlayer).SimonGruberModeShotHits = 0
	nShot = getSimonLitShot
	nProgress = 1 + Player(CurrentPlayer).SimonGruberModeProgress
	Select Case nShot
		Case eShotLoopLeft
			ChangeLamp eInsertBulletLoopLeft, 2 ,"red"	, 200,"10"	,1,0,0,0
			PupShowGameMessage "SIMON SAYS SHOOT THE LEFT ORBIT - SHOT " & nProgress & "/5"
		Case eShotLoopRight
			ChangeLamp eInsertBulletLoopRight, 2 ,"red"	, 200,"10"	,1,0,0,0
			PupShowGameMessage "SIMON SAYS SHOOT THE RIGHT ORBIT - SHOT " & nProgress & "/5"
		Case eShotCaptiveBall
			ChangeLamp eInsertComboCaptive, 2 ,"red"	, 200,"10"	,1,0,0,0
			PupShowGameMessage "SIMON SAYS SHOOT THE CAPTIVE BALL - SHOT " & nProgress & "/5"
		Case eShotRampRight
			ChangeLamp eInsertBulletRampRight, 2 ,"red"	, 200,"10"	,1,0,0,0
			PupShowGameMessage "SIMON SAYS SHOOT THE RIGHT RAMP - SHOT " & nProgress & "/5"
		Case eShotRampLeft
			ChangeLamp eInsertBulletRampLeft, 2 ,"red"	, 200,"10"	,1,0,0,0
			PupShowGameMessage "SIMON SAYS SHOOT THE LEFT RAMP - SHOT " & nProgress & "/5"
	End Select

	WriteToLog "NewSimonShot", "Lit shot is " & asShotNames(nShot)
	If Player(CurrentPlayer).HansBonus Then
		ModeTimeLeft = ModeTimeLeft + 30000
	Else
		ModeTimeLeft = ModeTimeLeft + 20000
	End If
	nDisplayTime = (ModeTimeLeft \ 1000) - 2
	ShowModeTimer nDisplayTime
End Sub

Sub CheckSimonGruberShots(shot)
	Dim nLitShot, nHits, nProgress
	WriteToLog "=================", "CheckSimonGruberShots " & asShotNames(shot)

	nLitShot = getSimonLitShot
	nHits = 0

	'if shot exists then add one to the shot counter
	if shot = nLitShot Then
		WriteToLog "CheckSimonGruberShots", "Hit registered, Lit shot = " _
			 & asShotNames(nLitShot) & ", hit shot = " & asShotNames(shot)
		nHits = Player(CurrentPlayer).SimonGruberModeShotHits
		nHits = nHits + 1
		lightCtrl.AddTableLightSeq "TEST", lSeqalllights2

		Player(CurrentPlayer).SimonGruberModeShotHits = nHits


		PlaySimonVideo ' Show a Simon video since its a Simon shot

		WriteToLog "CheckSimonGruberShots", "Current shot was hit " _
			 & Player(CurrentPlayer).SimonGruberModeShotHits & ", time(s)"
		' If second hit, then advance mode progress
		If nHits >= 1 Then
			Player(CurrentPlayer).SimonGruberModeProgress = _
				Player(CurrentPlayer).SimonGruberModeProgress + 1
			' Check if the player has completed the level
			if Player(CurrentPlayer).SimonGruberModeProgress >= nSimonShotsRequired Then
				AddScore score_simon_complete
				nVillainScore = nVillainScore + score_simon_complete
				WriteToLog "CheckSimonGruberShots ", "Completed"
				EndSimonGruber True
			Else
				AddScore score_simon_progress
				nVillainScore = nVillainScore + score_simon_progress
				NewSimonShot
			End If
		Else
			nProgress = 2 + (2 * Player(CurrentPlayer).SimonGruberModeProgress)
			Select Case nLitShot
				Case eShotLoopLeft
					PupShowGameMessage "SHOOT THE LEFT ORBIT AGAIN - SHOT " & nProgress & "/6"
				Case eShotLoopRight
					PupShowGameMessage "SHOOT THE RIGHT ORBIT AGAIN - SHOT " & nProgress & "/6"
				Case eShotCaptiveBall
					PupShowGameMessage "SHOOT THE CAPTIVE BALL AGAIN - SHOT " & nProgress & "/6"
			End Select
			ModeTimeLeft = 23000
			ShowModeTimer 20
		End If
	Else
		WriteToLog "CheckSimonGruberShots", "No hit, Lit shot = " & asShotNames(nLitShot) _
			& ", hit shot = " & asShotNames(shot)
	End If
End Sub

