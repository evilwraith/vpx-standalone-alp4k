	bulletattractcount = bulletattractcount + 1
	If bulletattractcount > 370 then bulletattractcount = 0 : bulletattractpos = bulletattractpos + 1 : If bulletattractpos > 4 then bulletattractpos = 0
	Select Case bulletattractpos
		case 0 :
			If bulletcolor1 < 250 then bulletcolor1 = bulletcolor1 + 1
			If bulletcolor1 > 250 then bulletcolor1 = bulletcolor1 - 1
			If bulletcolor2 < 166 then bulletcolor2 = bulletcolor2 + 1
			If bulletcolor2 > 166 then bulletcolor2 = bulletcolor2 - 1
