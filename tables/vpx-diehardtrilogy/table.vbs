Sub StartHansGruber()
	WriteToLog "=================", "StartHansGruber "
	ModeRunning = HansGruberMode
	InitHansGruber
	Player(CurrentPlayer).HansGruberModeProgress = 0
	pupChangeDMDBackground 1 ' Set Background to 1 for Nakatomi Background
	if (Player(CurrentPlayer).vaultTargetCount < 2) _
	And bVaultDoorOpen Then
		CloseVaultDoor
	End If
	UpdateLightsVault
	PlayHansVillainMode
	PupShowGameMessage "HIT THE STANDUP TARGETS - 8 LEFT"
	If Player(CurrentPlayer).HansBonus Then
		ModeTimeLeft = 123000
	Else
		ModeTimeLeft = 93000
	End If
	nVillainScore = 500000
	AddTimeAvailable = True
	ShowModeTimer 90
End Sub

'********************************************
' End Hans Gruber Mode
'********************************************
Sub EndHansGruber(bWon)
	WriteToLog "=================", "EndHansGruber, Mode won: " & bWon
	ModeRunning = NoModeEnabled
	ModeTimeLeft = 0
	AddTimeAvailable = False
	TargetHReset.Enabled = False
	TargetOReset.Enabled = False
	TargetL1Reset.Enabled = False
	TargetL2Reset.Enabled = False
	TargetYReset.Enabled = False
	HideModeTimer
	pupClearGameMessage
	If Player(CurrentPlayer).VaultMultiballReady Then OpenVaultDoor
	If bWon Then
		Player(CurrentPlayer).HansGruberModeComplete = true
		CheckModeExtraBall 5450
		CheckWizardMode
		If DIEHARDER = diehardMode Then
			Player(CurrentPlayer).HansBonus = True
		End If
		PlayHansDefeated
	Elseif BallsOnPlayfield > 0 Then
		If DIEHARDER = diehardMode Then
			PlayPlayerDiedHans
		Else
			PlayLostToHans
		End If
	End If

	' Todo : Add Method to restore previous lamp state before Hans Mode started
	If nVillainScore > Player(CurrentPlayer).BonusVillains(eVillainHans) Then
		Player(CurrentPlayer).BonusVillains(eVillainHans) = nVillainScore
	End If

	Player(CurrentPlayer).Collected_Bullets = MinimumBullets
	HansGruberPreStateRestore
	UpdateLightsAll
	GameplayRandomMusic
	SetGIColor GIdefault1,GIdefault2,GIdefault3
End Sub

