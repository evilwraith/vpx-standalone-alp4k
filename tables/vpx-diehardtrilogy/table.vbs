' Call this if user presses both flippers at once And
' 1. We are in a mode Or
' 2. We are drained
Sub pupCheckPlayerSkipVideo
	WriteToLog "PUP", "pupCheckPlayerSkipVideo"

	'Skip vault award display
	if nVaultMessage > 0 Then
		WriteToLog "PUP", "pupCheckPlayerSkip Skip Vault Award Timer"
		nVaultMessage = 15
		KickerVault1_timer
	'If in a mode or if in drain....then
	elseif YouWonPlaying = true then
		WriteToLog "PUP", "pupCheckPlayerSkip Skipping You Won Video"
		YouWonPlaying = false
		EndBonus
	elseif (ModeRunning <> NoModeEnabled) Then
		If "bonus" = ModeRunning Then
			WriteToLog "PUP", "pupCheckPlayerSkip Skipping bonus"
			'HideBonusLabels
			EndBonus
		Else
			WriteToLog "PUP", "pupCheckPlayerSkip stopping fullscreen viideo"
			pupStopFullscreenVideo
		End If
	elseif pupGameOver = true Then
		pupStopFullscreenVideo
		if GameOverVideoPlaying = true Then
			WriteToLog "PUP", "pupCheckPlayerSkip Skipping Game Over Video"
			GameOverVideoPlaying = False	
			delayedStartAttract
			GameOverVideoSkipped=true
			WriteToLog "PUP", "pupCheckPlayerSkip - GameOverVideo skipped, moving to attract"
		end if
		if EndGameScoreShowing = true Then
			HideEndGameScore
			WriteToLog "PUP", "pupCheckPlayerSkip - EndGameScore skipped, moving to Game Over if not already playing"
			if GameOverVideoSkipped = false AND GameOverVideoPlaying = false Then PlayGameOverVideo
