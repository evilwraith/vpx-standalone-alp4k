Sub DownloadIScoredLeaderboard ()
	WriteToLog "PUP", "DownloadIScoredLeaderboard"
	Dim score
	score = Player(CurrentPlayer).Score

	if IScoredEnabled = False OR PlayersPlayingGame <> 1 Then Exit Sub
	WriteToLog "PUP", "DownloadIScoredLeaderboard score " & score
	Dim objShell 
	Dim Command, rc
	
	Set objShell = CreateObject("WScript.Shell")
	Command = """" & puplayer.getroot & cGameName & "\iscored\IScoredInterface.exe " & """" & " POST " &  IScoredCabName & " " & score
	 
	rc = objShell.Run (Command, 0, False)

End Sub

