Sub checkParkMB(nShot)
	Dim i
	lightCtrl.AddLightSeq "NAME",lSeqAllLightsTopGreen
	WriteToLog "checkParkMB", "hit shot = " & asShotNames(nShot)
	If (Not Player(CurrentPlayer).ParkJPLit) _
	And ((Not Player(CurrentPlayer).ParkSuperCollected) _
	Or (Not Player(CurrentPlayer).ParkShotsHit.Contains(nShot))) Then
		WriteToLog "checkParkMB", "Park jackpot became lit"
		Player(CurrentPlayer).ParkPreviousShot = nShot
		AddScore score_ParkMBstart
		PupShowGameMessage "PARK JACKPOT IS LIT!"
		Player(CurrentPlayer).ParkJPLit = True

		For Each i in Array(eInsertBulletLoopLeft, eInsertBulletRampRight, _
		eInsertBulletLoopUpper, eInsertBulletLoopRight)
			ChangeLampState i, 0
		Next
		ChangeLamp eInsertBulletRampLeft, 2, "green", 200, "10", 1, 0, 0, 0

		For each i in Array(eInsertParkLeft, eInsertParkCenter, eInsertParkRight)
			ChangeLampState i, 1
		Next

		If Not Player(CurrentPlayer).rollover1 Then ChangeLampState eInsertParkLeft, 2
		If Not Player(CurrentPlayer).rollover2 Then ChangeLampState eInsertParkCenter, 2
		If Not Player(CurrentPlayer).rollover3 Then ChangeLampState eInsertParkRight, 2
	Else
		WriteToLog "checkParkMB", "Park jackpot didn't become lit"
	End If
End Sub

